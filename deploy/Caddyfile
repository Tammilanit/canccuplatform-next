# IP mode: plain http on port 80, no certificates (the TLS option follows #5).
# Routing: machine endpoints under /api/<module>/, module pages under /<module>/.
# handle_path strips the prefix, so each module keeps its own paths (/health, ...).
{
	auto_https off
	admin off
}

:80 {
	handle_path /api/hello/* {
		reverse_proxy hello:8080
	}

	# Admin's API paths are part of its contract (/api/admin/...), so they are not stripped;
	# only its health endpoint is mapped to the shared /health.
	handle /api/admin/health {
		rewrite * /health
		reverse_proxy admin:8080
	}

	handle /api/admin/* {
		reverse_proxy admin:8080
	}

	handle_path /admin/* {
		reverse_proxy admin:8080
	}

	handle {
		respond "not found" 404
	}
}
