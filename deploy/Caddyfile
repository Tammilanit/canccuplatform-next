# IP mode: plain http on port 80, no certificates (the TLS option follows #5).
# Routing: machine endpoints under /api/<module>/, module pages under /<module>/.
# handle_path strips the prefix, so each module keeps its own paths (/health, ...).
{
	auto_https off
	admin off
}

:80 {
	handle_path /api/hello/* {
		reverse_proxy hello:8080
	}

	# Admin's API paths are part of its contract (/api/admin/...), so they are not stripped;
	# only its health endpoint is mapped to the shared /health.
	handle /api/admin/health {
		rewrite * /health
		reverse_proxy admin:8080
	}

	handle /api/admin/* {
		reverse_proxy admin:8080
	}

	# The tenants contract's paths are /api/tenants/... too; /internal/tenants/ is never routed
	# here, so it stays on the stack's network.
	handle /api/tenants/health {
		rewrite * /health
		reverse_proxy tenants:8080
	}

	handle /api/tenants/* {
		reverse_proxy tenants:8080
	}

	# The screen contract's paths are /api/screen/... too, so they are not stripped either.
	handle /api/screen/health {
		rewrite * /health
		reverse_proxy screen:8080
	}

	handle /api/screen/* {
		reverse_proxy screen:8080
	}

	# The theming contract's paths are /api/theming/... and /theming/... (its served files), so
	# neither is stripped; /internal/theming/ is never routed here.
	handle /api/theming/health {
		rewrite * /health
		reverse_proxy theming:8080
	}

	handle /api/theming/* {
		reverse_proxy theming:8080
	}

	handle /theming/* {
		reverse_proxy theming:8080
	}

	# The agenda contract's paths are /api/agenda/... too.
	handle /api/agenda/health {
		rewrite * /health
		reverse_proxy agenda:8080
	}

	handle /api/agenda/* {
		reverse_proxy agenda:8080
	}

	# The notify contract's paths are /api/notify/... too; /internal/notify/ is never routed.
	handle /api/notify/health {
		rewrite * /health
		reverse_proxy notify:8080
	}

	handle /api/notify/* {
		reverse_proxy notify:8080
	}

	# Notify's pages (the check-in page a scanned QR opens): prefix stripped like admin's.
	handle_path /notify/* {
		reverse_proxy notify:8080
	}

	handle_path /admin/* {
		reverse_proxy admin:8080
	}

	handle {
		respond "not found" 404
	}
}
