# IP mode: plain http on port 80, no certificates (the TLS option follows #5).
# Routing: machine endpoints under /api/<module>/, module pages under /<module>/.
# handle_path strips the prefix, so each module keeps its own paths (/health, ...).
{
	auto_https off
	admin off
}

:80 {
	handle_path /api/hello/* {
		reverse_proxy hello:8080
	}

	# Admin's API paths are part of its contract (/api/admin/...), so they are not stripped;
	# only its health endpoint is mapped to the shared /health.
	handle /api/admin/health {
		rewrite * /health
		reverse_proxy admin:8080
	}

	handle /api/admin/* {
		reverse_proxy admin:8080
	}

	# The tenants contract's paths are /api/tenants/... too; /internal/tenants/ is never routed
	# here, so it stays on the stack's network.
	handle /api/tenants/health {
		rewrite * /health
		reverse_proxy tenants:8080
	}

	handle /api/tenants/* {
		reverse_proxy tenants:8080
	}

	# The screen contract's paths are /api/screen/... too, so they are not stripped either.
	handle /api/screen/health {
		rewrite * /health
		reverse_proxy screen:8080
	}

	handle /api/screen/* {
		reverse_proxy screen:8080
	}

	# The kiosk's page and its bundle (/screen/, /screen/b/<version>/): screen's own paths, not
	# stripped. The bare prefix goes to the page, with a link's query.
	handle /screen {
		redir * /screen/{?query} 308
	}

	handle /screen/* {
		reverse_proxy screen:8080
	}

	# The theming contract's paths are /api/theming/... and /theming/... (its served files), so
	# neither is stripped; /internal/theming/ is never routed here.
	handle /api/theming/health {
		rewrite * /health
		reverse_proxy theming:8080
	}

	handle /api/theming/* {
		reverse_proxy theming:8080
	}

	handle /theming/* {
		reverse_proxy theming:8080
	}

	# The agenda contract's paths are /api/agenda/... too.
	handle /api/agenda/health {
		rewrite * /health
		reverse_proxy agenda:8080
	}

	handle /api/agenda/* {
		reverse_proxy agenda:8080
	}

	# The run-of-show pages, in one named-matcher block, as every module's pages below: Caddy
	# sorts the top-level path routes, and a hidden-path rule next to its prefix lands behind it
	# whenever a route is added or removed. Inside, only named matchers and a last catch-all,
	# which Caddy keeps in the order written. The module's own paths start at /.
	@agenda-pages path /agenda /agenda/*
	handle @agenda-pages {
		# The strip below would pass /agenda/internal/... on as agenda's internal paths (never
		# routed, contracts/README.md), and /agenda/api/... and /agenda/health as a second way into
		# what /api/agenda/ above already serves.
		@agenda-hidden path /agenda/internal/* /agenda/api/* /agenda/health
		handle @agenda-hidden {
			respond "not found" 404
		}

		# The pages' links all start /agenda/, so the bare prefix goes there, with a link's query.
		@agenda-bare path /agenda
		handle @agenda-bare {
			redir * /agenda/{?query} 308
		}

		handle {
			uri strip_prefix /agenda
			reverse_proxy agenda:8080
		}
	}

	# The notify contract's paths are /api/notify/... too; /internal/notify/ is never routed.
	handle /api/notify/health {
		rewrite * /health
		reverse_proxy notify:8080
	}

	handle /api/notify/* {
		reverse_proxy notify:8080
	}

	# The notification pages under admin's "Event" menu and the check-in page a scanned QR
	# opens, in one block as for agenda; the module's own paths start at /.
	@notify-pages path /notify /notify/*
	handle @notify-pages {
		# As for agenda: the strip below would pass these on as notify's internal paths or as a
		# second way into what /api/notify/ above already serves.
		@notify-hidden path /notify/internal/* /notify/api/* /notify/health
		handle @notify-hidden {
			respond "not found" 404
		}

		# Notify has no page at /notify/; its first page is the topic list admin's menu links to.
		@notify-bare path /notify /notify/
		handle @notify-bare {
			redir * /notify/admin/topics{?query} 308
		}

		handle {
			uri strip_prefix /notify
			reverse_proxy notify:8080
		}
	}

	# The pizza contract's paths are /api/pizza/...; its pages are under /pizza/.
	handle /api/pizza/health {
		rewrite * /health
		reverse_proxy pizza:8080
	}

	handle /api/pizza/* {
		reverse_proxy pizza:8080
	}

	# The Food pages: the holder's (/pizza/hold/) and the crew's (/pizza/crew/), in one block as
	# for agenda; the module's own paths start at /.
	@pizza-pages path /pizza /pizza/*
	handle @pizza-pages {
		# As for agenda: the strip below would pass these on as pizza's internal paths or as a
		# second way into what /api/pizza/ above already serves.
		@pizza-hidden path /pizza/internal/* /pizza/api/* /pizza/health
		handle @pizza-hidden {
			respond "not found" 404
		}

		@pizza-bare path /pizza
		handle @pizza-bare {
			redir * /pizza/{?query} 308
		}

		handle {
			uri strip_prefix /pizza
			reverse_proxy pizza:8080
		}
	}

	# The moments contract's paths are /api/moments/... too; /internal/moments/ is never routed.
	handle /api/moments/health {
		rewrite * /health
		reverse_proxy moments:8080
	}

	handle /api/moments/* {
		reverse_proxy moments:8080
	}

	# Studio → Moments (the Screen studio's Moments tab), in one block as for agenda; the module's
	# own paths start at /.
	@moments-pages path /moments /moments/*
	handle @moments-pages {
		# As for agenda: the strip below would pass these on as moments' internal paths or as a
		# second way into what /api/moments/ above already serves.
		@moments-hidden path /moments/internal/* /moments/api/* /moments/health
		handle @moments-hidden {
			respond "not found" 404
		}

		@moments-bare path /moments
		handle @moments-bare {
			redir * /moments/{?query} 308
		}

		handle {
			uri strip_prefix /moments
			reverse_proxy moments:8080
		}
	}

	# Admin's pages, and inside them screen's Studio pages, which the kiosk's pairing QR opens
	# (/admin/screen/devices#pair=, contracts/screen.md, Pairing): screen's own paths, given back
	# their prefix. They sit in this block, not in a handle of their own: Caddy sorts the top-level
	# path routes (see agenda's block above).
	handle_path /admin/* {
		@screen-studio path /screen/*
		handle @screen-studio {
			rewrite * /admin{path}
			reverse_proxy screen:8080
		}

		handle /screen {
			redir * /admin/screen/{?query} 308
		}

		handle {
			reverse_proxy admin:8080
		}
	}

	handle {
		respond "not found" 404
	}
}
