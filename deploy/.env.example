# Copy to deploy/.env (never commit it) and change the values.
# Without this file compose.yml uses a placeholder Postgres password that is for local use only.
POSTGRES_PASSWORD=change-me
# Platform version (git tag) the modules report in /health.
CP_VERSION=dev
# Sources allowed to reach the web ports 80 and 443 (setup/firewall): IPv4/IPv6 addresses or
# CIDRs, space or comma separated, or `any` for everyone. Required for `setup/install --boot`;
# keep it in line with the host's ufw rules. Real addresses go in deploy/.env only, never here.
CP_WEB_ALLOW=
