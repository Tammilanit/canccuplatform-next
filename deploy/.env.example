# Copy to deploy/.env (never commit it) and change the values.
# Without this file compose.yml uses a placeholder Postgres password that is for local use only.
POSTGRES_PASSWORD=change-me
# Platform version (git tag) the modules report in /health. While it is dev, setup/deploy
# (canccu-deploy.timer) deploys every merge to main on this host (setup/README.md, Auto-deploy).
CP_VERSION=dev
# Sources allowed to reach the web ports 80 and 443 (setup/firewall): IPv4/IPv6 addresses or
# CIDRs, space or comma separated, or `any` for everyone. Required for `setup/install --boot`.
# ufw does not see published ports, so this is their filter. Real addresses go in deploy/.env
# only, never here.
CP_WEB_ALLOW=
# Auto-deploy (setup/deploy): a fine-grained GitHub token for this repo only, with Issues read and
# write, to open an issue when a deploy fails. Never commit it.
CP_DEPLOY_GITHUB_TOKEN=
