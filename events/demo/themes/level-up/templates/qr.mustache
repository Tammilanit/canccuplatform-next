{{! Field names are placeholders until the screen contract names the qr widget's fields. }}
{{! qr_url is the image address the widget documents; the code sits on a light tile so phones read it. }}
<h2 class="canccu-widget__title">{{title}}</h2>
<div class="t-qr">
  <div class="t-qr__code"><img src="{{qr_url}}" alt="{{alt}}"></div>
  <div class="t-qr__text">
    <p class="t-qr__caption">{{caption}}</p>
    <p class="t-qr__link">{{link_text}}</p>
  </div>
</div>
