{{! The ticker's line (contracts/screen.md, ticker: text). It renders twice so the scroll loops without
    a gap; the copy is hidden from screen readers. }}
<div class="t-ticker">
  <div class="t-ticker__track">
    <span class="t-ticker__run"><span class="t-ticker__item">{{text}}</span></span>
    <span class="t-ticker__run" aria-hidden="true"><span class="t-ticker__item">{{text}}</span></span>
  </div>
</div>
