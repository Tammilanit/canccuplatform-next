#!/usr/bin/env python3
"""Tenancy lint (0013 items 5-7, contracts/tenants.md; docs/ci.md#tenancy).

Every table a module's migrations create (`modules/<module>/migrations/*.sql`) is a tenant table
unless `scripts/tenancy-global-tables.txt` lists it. A tenant table needs a `tenant_id` column,
row-level security enabled and forced, a policy on the kit's tenant setting, `tenant_id` in every
primary key, unique constraint and unique index, and composite foreign keys with `tenant_id`
(a plain reference is allowed only to a global table); it drops no policy, tenant_id or constraint,
except a CHECK the same migration adds back. Module source must not spell Valkey keys
or stream names (`"events:…"`, `"t:…"`, in TS `"<module>:…"`) itself: the kit builds them.

Usage: check-tenancy [DIR]    (default: the repo root; scans `git ls-files`)
       check-tenancy --self-test
Exit 1 lists `file: problem`; exit 2 on a broken run.

The SQL reader is deliberately small: it understands the statements migrations use (CREATE
TABLE, ALTER TABLE, CREATE [UNIQUE] INDEX, CREATE POLICY) and ignores the rest, so DDL built at
runtime in code is invisible to it.
"""

from __future__ import annotations

import re
import subprocess
import sys
import tempfile
from dataclasses import dataclass, field
from pathlib import Path

ALLOW_LIST = "scripts/tenancy-global-tables.txt"
MIGRATION_RE = re.compile(r"^modules/([a-z][a-z0-9_]*)/migrations/.+\.sql$")
SOURCE_RE = re.compile(r"^modules/[a-z][a-z0-9_]*/src/.+\.(ts|tsx|js|mjs|py)$")
RAW_KEY_RE = re.compile(r"""["'`](events|t):""")
# `"<module>:…"` is what `platformKey` builds, in kit-ts only: kit-py has no counterpart yet.
PLATFORM_KEY_SOURCE = (".ts", ".tsx", ".js", ".mjs")
TENANT_SETTING = "current_setting('canccu.tenant'"
IDENT = r'(?:"[^"]+"|[A-Za-z_][A-Za-z0-9_$]*)'
NAME = rf"((?:{IDENT}\.)?{IDENT})"


def bare(name: str) -> str:
    """Table name without schema or quotes, lowercased."""
    return name.split(".")[-1].strip('"').lower()


def constraint_name(name: str) -> str:
    """Postgres folds unquoted names to lower case and cuts every name to 63 bytes, never inside
    a character."""
    name = name[1:-1] if name.startswith('"') else name.lower()
    return name.encode()[:63].decode("utf-8", "ignore")


# Postgres names an unnamed key, unique, exclusion or foreign key <table>_…_<suffix>[digits], so
# a CHECK's name of that shape can be taken by a key the reader never saw named.
KEY_NAME_RE = re.compile(r"_(?:pkey|key|fkey|excl)[0-9]*$")


def statements(sql: str) -> list[str]:
    """Split on top-level `;`, dropping comments; quotes and dollar quotes are kept whole."""
    out, buf, i = [], [], 0
    while i < len(sql):
        c = sql[i]
        if sql.startswith("--", i):
            i = sql.find("\n", i) if "\n" in sql[i:] else len(sql)
            continue
        if sql.startswith("/*", i):
            end = sql.find("*/", i + 2)
            i = len(sql) if end == -1 else end + 2
            continue
        if c in "'\"":
            end = i + 1
            while end < len(sql) and sql[end] != c:
                end += 1
            buf.append(sql[i : end + 1])
            i = end + 1
            continue
        tag = re.match(r"\$[A-Za-z0-9_]*\$", sql[i:])
        if tag:
            end = sql.find(tag.group(0), i + len(tag.group(0)))
            end = len(sql) if end == -1 else end + len(tag.group(0))
            buf.append(sql[i:end])
            i = end
            continue
        if c == ";":
            out.append("".join(buf).strip())
            buf = []
        else:
            buf.append(c)
        i += 1
    out.append("".join(buf).strip())
    return [" ".join(s.split()) for s in out if s.strip()]


def split_top(body: str) -> list[str]:
    """Split a parenthesised list on top-level commas."""
    parts, depth, start = [], 0, 0
    for i, c in enumerate(body):
        depth += c == "("
        depth -= c == ")"
        if c == "," and depth == 0:
            parts.append(body[start:i].strip())
            start = i + 1
    parts.append(body[start:].strip())
    return [p for p in parts if p]


def paren_body(text: str, open_at: int) -> str:
    depth = 0
    for i in range(open_at, len(text)):
        depth += text[i] == "("
        depth -= text[i] == ")"
        if depth == 0:
            return text[open_at + 1 : i]
    return text[open_at + 1 :]


def columns(text: str) -> list[str]:
    return [bare(c) for c in split_top(text)]


@dataclass
class Table:
    file: str
    name: str
    has_tenant_column: bool = False
    rls: bool = False
    forced: bool = False
    policies: list[tuple[str, bool, bool, bool]] = field(default_factory=list)
    # (name, permissive, covers all commands, uses the tenant setting)
    drops: list[tuple[str, str]] = field(default_factory=list)  # (migration file, what it drops)
    keys: list[tuple[str, list[str]]] = field(default_factory=list)  # (kind, columns)
    refs: list[tuple[list[str], str, list[str] | None]] = field(default_factory=list)
    # Constraint name -> every kind ("check", "other") seen under it: a drop passes only for a
    # name never seen as anything but a CHECK, and only once the same migration adds it back.
    constraints: dict[str, set[str]] = field(default_factory=dict)
    unrestored: set[str] = field(default_factory=set)

    def name_constraint(self, name: str, kind: str) -> None:
        self.constraints.setdefault(constraint_name(name), set()).add(kind)


@dataclass
class Module:
    tables: dict[str, Table] = field(default_factory=dict)
    problems: list[str] = field(default_factory=list)

    def table(self, name: str) -> Table | None:
        return self.tables.get(bare(name))

    def end_migration(self, file: str) -> None:
        for table in self.tables.values():
            table.drops += [
                (file, f"drops CHECK {n} without adding it back in the same migration") for n in sorted(table.unrestored)
            ]
            table.unrestored.clear()


def read_constraint(table: Table, element: str) -> None:
    """A table-level PRIMARY KEY, UNIQUE or FOREIGN KEY clause (CONSTRAINT name optional)."""
    named = re.match(rf"CONSTRAINT ({IDENT}) ", element, re.I)
    element = element[named.end() :] if named else element
    if named:
        table.name_constraint(named.group(1), "check" if re.match(r"CHECK\b", element, re.I) else "other")
    index = re.search(rf"\bUSING INDEX ({IDENT})", element, re.I)
    if index:  # the constraint takes the index's name
        table.name_constraint(index.group(1), "other")
    m = re.match(r"(PRIMARY KEY|UNIQUE(?: NULLS (?:NOT )?DISTINCT)?) \(", element, re.I)
    if m:
        kind = "primary key" if m.group(1).upper().startswith("PRIMARY") else "unique"
        table.keys.append((kind, columns(paren_body(element, m.end() - 1))))
        return
    m = re.match(r"FOREIGN KEY \(", element, re.I)
    if m:
        read_reference(table, columns(paren_body(element, m.end() - 1)), element)


def read_column(table: Table, element: str) -> None:
    name = bare(element.split(" ", 1)[0])
    if name == "tenant_id":
        table.has_tenant_column = True
    rest = element.split(" ", 1)[1] if " " in element else ""
    named = re.findall(rf"\bCONSTRAINT ({IDENT}) (\w+)", rest, re.I)
    for constraint, kind in named:
        table.name_constraint(constraint, "check" if kind.upper() == "CHECK" else "other")
    # An unnamed column CHECK is named <table>_<column>_check (longer names are cut in ways not
    # modelled here, so their drops fail). A stray "CHECK" in a literal only adds a _check name,
    # which no key, foreign key or exclusion is ever named by default. bare() lowercases quoted
    # names too, so for a quoted mixed-case table or column this is not Postgres's name and the
    # drop fails: closed, never open.
    auto = f"{table.name}_{name}_check"
    if len(re.findall(r"\bCHECK\b", rest, re.I)) > sum(k.upper() == "CHECK" for _, k in named) and len(auto.encode()) <= 63:
        table.name_constraint(auto, "check")
    if re.search(r"\bPRIMARY KEY\b", rest, re.I):
        table.keys.append(("primary key", [name]))
    if re.search(r"\bUNIQUE\b", rest, re.I):
        table.keys.append(("unique", [name]))
    read_reference(table, [name], rest)


def read_reference(table: Table, local: list[str], text: str) -> None:
    """Target columns are None when left out; SQL then means the target's primary key."""
    ref = re.search(rf"\bREFERENCES {NAME}\s*(\()?", text, re.I)
    if ref:
        target = columns(paren_body(text, ref.end() - 1)) if ref.group(2) else None
        table.refs.append((local, bare(ref.group(1)), target))


CONSTRAINT_START = re.compile(r"^(CONSTRAINT|PRIMARY KEY|UNIQUE|FOREIGN KEY|CHECK|EXCLUDE)\b", re.I)


def read_element(table: Table, element: str) -> None:
    if CONSTRAINT_START.match(element):
        read_constraint(table, element)
    else:
        read_column(table, element)


def read_statement(module: Module, stmt: str, file: str) -> None:
    m = re.match(rf"CREATE (?:UNLOGGED )?TABLE (?:IF NOT EXISTS )?{NAME}\s*\(", stmt, re.I)
    if m:
        table = module.tables.setdefault(bare(m.group(1)), Table(file, bare(m.group(1))))
        for element in split_top(paren_body(stmt, m.end() - 1)):
            read_element(table, element)
        return
    m = re.match(rf"CREATE UNIQUE INDEX (?:CONCURRENTLY )?(?:IF NOT EXISTS )?(?:{IDENT} )?ON (?:ONLY )?{NAME}(?: USING \w+)?\s*\(", stmt, re.I)
    if m and (table := module.table(m.group(1))):
        table.keys.append(("unique index", columns(paren_body(stmt, m.end() - 1))))
        return
    m = re.match(rf"CREATE POLICY ({IDENT}) ON {NAME}\b(.*)", stmt, re.I)
    if m and (table := module.table(m.group(2))):
        rest = m.group(3)
        command = re.search(r"\bFOR (ALL|SELECT|INSERT|UPDATE|DELETE)\b", rest, re.I)
        table.policies.append((
            bare(m.group(1)),
            re.search(r"\bAS RESTRICTIVE\b", rest, re.I) is None,
            command is None or command.group(1).upper() == "ALL",
            TENANT_SETTING in rest.replace('"', "'"),
        ))
        return
    m = re.match(rf"DROP POLICY (?:IF EXISTS )?({IDENT}) ON {NAME}", stmt, re.I)
    if m and (table := module.table(m.group(2))):
        table.drops.append((file, f"drops policy {bare(m.group(1))}"))
        return
    # Postgres lets ALTER INDEX rename a table and ALTER TABLE rename an index.
    m = re.match(rf"ALTER (?:INDEX|TABLE) (?:IF EXISTS )?(?:ONLY )?{NAME} RENAME TO ({IDENT})\s*$", stmt, re.I)
    if m:
        if table := module.table(m.group(1)):
            # The table keeps everything it had under its new name, so later statements stay checked.
            module.tables[bare(m.group(2))] = module.tables.pop(bare(m.group(1)))
            table.name = bare(m.group(2))
        else:
            # Renaming the index behind a primary key, unique or exclusion constraint renames the
            # constraint too. Index names are schema-wide, so the new name may be a key on any table.
            for each in module.tables.values():
                each.name_constraint(m.group(2), "other")
        return
    m = re.match(rf"ALTER TABLE (?:IF EXISTS )?(?:ONLY )?{NAME} (.*)", stmt, re.I)
    if not m or not (table := module.table(m.group(1))):
        return
    renamed = re.match(rf"RENAME CONSTRAINT ({IDENT}) TO ({IDENT})\s*$", m.group(2), re.I)
    if renamed:
        kinds = table.constraints.pop(constraint_name(renamed.group(1)), {"other"})
        table.constraints.setdefault(constraint_name(renamed.group(2)), set()).update(kinds)
        return
    for action in split_top(m.group(2)):
        upper = action.upper()
        if upper.startswith("ENABLE ROW LEVEL SECURITY"):
            table.rls = True
        elif upper.startswith("FORCE ROW LEVEL SECURITY"):
            table.forced = True
        elif upper.startswith(("DISABLE ROW LEVEL SECURITY", "NO FORCE ROW LEVEL SECURITY")):
            module.problems.append(f"{file}: {bare(m.group(1))}: turns row-level security off")
        elif upper.startswith("DROP CONSTRAINT"):
            # CASCADE could take more than the CHECK with it, so only a plain drop passes.
            plain = re.fullmatch(rf"DROP CONSTRAINT (?:IF EXISTS )?({IDENT})(?: RESTRICT)?", action, re.I)
            name = constraint_name(plain.group(1)) if plain else ""
            if not plain:
                table.drops.append((file, f"drops a constraint with CASCADE or in a form not read here ({action})"))
            elif table.constraints.get(name) != {"check"} or KEY_NAME_RE.search(name):
                table.drops.append((file, (
                    f"drops constraint {name}, not known as a CHECK only (a key, foreign key, "
                    "unnamed or renamed constraint, or a name Postgres gives keys)"
                )))
            else:
                table.unrestored.add(name)
        elif re.match(r"DROP (?:COLUMN )?(?:IF EXISTS )?\"?tenant_id\b", action, re.I):
            table.drops.append((file, "drops tenant_id"))
        elif upper.startswith("ADD "):
            element = re.sub(r"^ADD (?:COLUMN )?(?:IF NOT EXISTS )?", "", action, flags=re.I)
            read_element(table, element)
            added = re.match(rf"CONSTRAINT ({IDENT}) CHECK\b", element, re.I)
            if added:
                table.unrestored.discard(constraint_name(added.group(1)))


def table_problems(name: str, table: Table, is_global: set[str]) -> list[str]:
    where = f"{table.file}: {name}"
    found = []
    if not table.has_tenant_column:
        found.append(f"{where}: no tenant_id column")
    if not table.rls:
        found.append(f"{where}: row-level security not enabled")
    if not table.forced:
        found.append(f"{where}: row-level security not forced")
    # Postgres ORs permissive policies: one without the tenant setting opens the table, and a
    # tenant policy for some commands only leaves the others unguarded.
    if not any(setting and every for _, _, every, setting in table.policies):
        found.append(f"{where}: no policy for all commands on the tenant setting ({TENANT_SETTING}…)")
    for policy, permissive, _, setting in table.policies:
        if permissive and not setting:
            found.append(f"{where}: permissive policy {policy} without the tenant setting")
    # A drop is reported in the migration that made it, not the one that created the table.
    found += [f"{file}: {name}: {drop}" for file, drop in table.drops]
    for kind, cols in table.keys:
        if "tenant_id" not in cols:
            found.append(f"{where}: {kind} ({', '.join(cols)}) without tenant_id")
    for local, target, target_cols in table.refs:
        if target in is_global:
            continue
        if "tenant_id" not in local or target_cols is None or "tenant_id" not in target_cols:
            found.append(
                f"{where}: foreign key ({', '.join(local)}) to {target} is not composite with tenant_id"
            )
    return found


def read_allow_list(root: Path) -> tuple[dict[str, set[str]], list[str]]:
    allowed: dict[str, set[str]] = {}
    problems = []
    path = root / ALLOW_LIST
    if not path.exists():
        return allowed, problems
    for n, line in enumerate(path.read_text().splitlines(), 1):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        parts = line.split(None, 2)
        if len(parts) < 3:
            problems.append(f"{ALLOW_LIST}:{n}: entry without a reason exempts nothing: {line.strip()}")
            continue
        allowed.setdefault(parts[0], set()).add(parts[1].lower())
    return allowed, problems


def check(root: Path) -> list[str]:
    files = subprocess.run(
        ["git", "-C", str(root), "ls-files"], capture_output=True, text=True, check=True
    ).stdout.splitlines()
    allowed, problems = read_allow_list(root)
    names = sorted({f.split("/")[1] for f in files if f.startswith("modules/") and f.count("/") > 1})
    raw_platform_key = re.compile(rf"""["'`]({"|".join(map(re.escape, names))}):[^\s"'`]""" if names else "(?!)")
    modules: dict[str, Module] = {}
    for file in sorted(files):
        m = MIGRATION_RE.match(file)
        if m:
            module = modules.setdefault(m.group(1), Module())
            for stmt in statements((root / file).read_text()):
                read_statement(module, stmt, file)
            module.end_migration(file)
        elif SOURCE_RE.match(file):
            for n, line in enumerate((root / file).read_text().splitlines(), 1):
                if RAW_KEY_RE.search(line):
                    problems.append(
                        f"{file}:{n}: raw Valkey key or stream name; use the kit's "
                        "tenantStream/tenantKey (tenant_stream/tenant_key)"
                    )
                elif file.endswith(PLATFORM_KEY_SOURCE) and raw_platform_key.search(line):
                    problems.append(f"{file}:{n}: raw platform key; use the kit's platformKey")
    for name, module in sorted(modules.items()):
        problems += module.problems
        # Only the module's own global tables exempt a plain reference: a same-named table that
        # another module lists says nothing about this one.
        own_global = allowed.get(name, set())
        for table_name, table in sorted(module.tables.items()):
            if table_name not in own_global:
                problems += table_problems(table_name, table, own_global)
    return problems


GOOD = """
CREATE TABLE lists (
  tenant_id text NOT NULL DEFAULT NULLIF(current_setting('canccu.tenant', true), ''),
  id text NOT NULL, venue_id text REFERENCES venues (id), note text DEFAULT 'a;b' CHECK (note <> ''),
  PRIMARY KEY (tenant_id, id)
);
-- a comment; with a semicolon
CREATE TABLE items (
  tenant_id text NOT NULL, id text NOT NULL, list_id text NOT NULL,
  CONSTRAINT items_pk PRIMARY KEY (tenant_id, id), CONSTRAINT items_id CHECK (id <> ''),
  CONSTRAINT items_list FOREIGN KEY (tenant_id, list_id) REFERENCES lists (tenant_id, id)
);
CREATE UNIQUE INDEX items_name ON items (tenant_id, id);
DO $$ BEGIN PERFORM 1; END $$;
"""
RLS = """
ALTER TABLE {t} ENABLE ROW LEVEL SECURITY;
ALTER TABLE {t} FORCE ROW LEVEL SECURITY;
CREATE POLICY canccu_tenant ON {t} USING (tenant_id = NULLIF(current_setting('canccu.tenant', true), ''))
  WITH CHECK (tenant_id = NULLIF(current_setting('canccu.tenant', true), ''));
"""
GLOBALS = "# module table reason\nm venues global registry of venues\nscreen devices device rows\n"


def self_test() -> int:
    cases: list[tuple[str, dict[str, str], str | None]] = [
        ("good tables pass", {}, None),
        ("missing tenant_id", {"m.sql": "CREATE TABLE x (id text PRIMARY KEY);"}, "x: no tenant_id column"),
        ("no RLS", {"m.sql": "CREATE TABLE x (tenant_id text, id text, PRIMARY KEY (tenant_id, id));"}, "x: row-level security not enabled"),
        ("not forced", {"m.sql": "CREATE TABLE x (tenant_id text);\nALTER TABLE x ENABLE ROW LEVEL SECURITY;"}, "x: row-level security not forced"),
        ("no policy", {"m.sql": "CREATE TABLE x (tenant_id text);"}, "x: no policy"),
        ("single-column primary key", {"m.sql": "CREATE TABLE x (tenant_id text, id text PRIMARY KEY);"}, r"x: primary key \(id\) without tenant_id"),
        ("unique without tenant", {"m.sql": "CREATE TABLE x (tenant_id text, code text, UNIQUE (code));"}, r"x: unique \(code\) without tenant_id"),
        ("unique index without tenant", {"m.sql": "CREATE TABLE x (tenant_id text, code text);\nCREATE UNIQUE INDEX x_code ON x (code);"}, r"unique index \(code\) without tenant_id"),
        ("plain foreign key to a tenant table", {"m.sql": "CREATE TABLE x (tenant_id text, list_id text REFERENCES lists (id));"}, r"foreign key \(list_id\) to lists is not composite"),
        ("added foreign key", {"m.sql": "CREATE TABLE x (tenant_id text, l text);\nALTER TABLE x ADD CONSTRAINT f FOREIGN KEY (l) REFERENCES lists (id);"}, r"foreign key \(l\) to lists"),
        ("RLS turned off", {"m.sql": "ALTER TABLE lists DISABLE ROW LEVEL SECURITY;"}, "lists: turns row-level security off"),
        ("listed global table is exempt", {"m.sql": "CREATE TABLE settings (id text PRIMARY KEY);", "globals": "m settings platform-wide settings\n"}, None),
        ("entry without a reason", {"m.sql": "CREATE TABLE settings (id text PRIMARY KEY);", "globals": "m settings\n"}, "entry without a reason"),
        ("permissive policy without the setting", {"m.sql": "CREATE POLICY open ON lists USING (true);"}, "lists: permissive policy open without the tenant setting"),
        ("restrictive policy without the setting narrows only", {"m.sql": "CREATE POLICY no_archived ON lists AS RESTRICTIVE USING (id <> 'x');"}, None),
        ("tenant policy for SELECT only", {"m.sql": "CREATE TABLE x (tenant_id text);\nALTER TABLE x ENABLE ROW LEVEL SECURITY;\nALTER TABLE x FORCE ROW LEVEL SECURITY;\nCREATE POLICY p ON x FOR SELECT USING (tenant_id = current_setting('canccu.tenant', true));"}, "x: no policy for all commands"),
        ("dropped policy", {"m.sql": "DROP POLICY canccu_tenant ON lists;"}, "lists: drops policy canccu_tenant"),
        ("dropped tenant_id", {"m.sql": "ALTER TABLE lists DROP COLUMN tenant_id;"}, "lists: drops tenant_id"),
        ("dropped constraint", {"m.sql": "ALTER TABLE items DROP CONSTRAINT items_list;"}, "items: drops constraint items_list, not known as a CHECK"),
        ("a CHECK dropped and added back", {"m.sql": "ALTER TABLE lists DROP CONSTRAINT lists_note_check;\nALTER TABLE lists ADD CONSTRAINT lists_note_check CHECK (note ~ 'x');\nALTER TABLE items DROP CONSTRAINT IF EXISTS items_id, ADD CONSTRAINT items_id CHECK (id ~ 'x');"}, None),
        ("a CHECK not added back", {"m.sql": "ALTER TABLE lists DROP CONSTRAINT lists_note_check;"}, r"002_more.sql: lists: drops CHECK lists_note_check without adding it back"),
        ("a CHECK added back in a later migration", {"m.sql": "ALTER TABLE lists DROP CONSTRAINT lists_note_check;", "modules/m/migrations/003_x.sql": "ALTER TABLE lists ADD CONSTRAINT lists_note_check CHECK (note ~ 'x');"}, r"002_more.sql: lists: drops CHECK lists_note_check without"),
        ("a CHECK added back under another name", {"m.sql": "ALTER TABLE lists DROP CONSTRAINT lists_note_check;\nALTER TABLE lists ADD CONSTRAINT lists_note_check2 CHECK (note ~ 'x');"}, "lists: drops CHECK lists_note_check without"),
        ("a CHECK added back on another table", {"m.sql": "ALTER TABLE lists DROP CONSTRAINT lists_note_check;\nALTER TABLE items ADD CONSTRAINT lists_note_check CHECK (id ~ 'x');"}, "lists: drops CHECK lists_note_check without"),
        ("a CHECK added back as a key", {"m.sql": "ALTER TABLE items DROP CONSTRAINT items_id;\nALTER TABLE items ADD CONSTRAINT items_id UNIQUE (tenant_id, id);"}, "items: drops CHECK items_id without"),
        ("a foreign key replaced by a CHECK", {"m.sql": "ALTER TABLE items DROP CONSTRAINT items_list;\nALTER TABLE items ADD CONSTRAINT items_list CHECK (id ~ 'x');"}, "items: drops constraint items_list, not known"),
        ("a key renamed to a CHECK's name", {"m.sql": "ALTER TABLE items DROP CONSTRAINT items_id;\nALTER TABLE items RENAME CONSTRAINT items_pk TO items_id;\nALTER TABLE items DROP CONSTRAINT items_id, ADD CONSTRAINT items_id CHECK (id ~ 'x');"}, "items: drops constraint items_id, not known"),
        ("an index renamed to a dropped CHECK's name", {"m.sql": "ALTER TABLE lists DROP CONSTRAINT lists_note_check;\nALTER INDEX lists_pkey RENAME TO lists_note_check;\nALTER TABLE lists DROP CONSTRAINT lists_note_check;\nALTER TABLE lists ADD CONSTRAINT lists_note_check CHECK (note <> '');"}, "lists: drops constraint lists_note_check, not known"),
        ("an index renamed by ALTER TABLE", {"m.sql": "ALTER TABLE lists DROP CONSTRAINT lists_note_check;\nALTER TABLE IF EXISTS lists_pkey RENAME TO lists_note_check;\nALTER TABLE lists DROP CONSTRAINT lists_note_check, ADD CONSTRAINT lists_note_check CHECK (note <> '');"}, "lists: drops constraint lists_note_check, not known"),
        ("an unnamed key takes a dropped CHECK's name", {"m.sql": "CREATE TABLE x (tenant_id text, id text, CONSTRAINT x_pkey CHECK (id <> ''));\nALTER TABLE x DROP CONSTRAINT x_pkey, ADD CONSTRAINT x_pkey CHECK (id ~ 'x');"}, "x: drops constraint x_pkey, not known"),
        ("a long multibyte CHECK name is cut to 63 bytes", {"m.sql": f'CREATE TABLE x (tenant_id text, id text, PRIMARY KEY (tenant_id, id), CONSTRAINT "{"ä" * 40}" CHECK (id <> \'\'));' + RLS.format(t="x") + f'ALTER TABLE x DROP CONSTRAINT "{"ä" * 31}", ADD CONSTRAINT "{"ä" * 40}" CHECK (id ~ \'x\');'}, None),
        ("a CHECK dropped with CASCADE", {"m.sql": "ALTER TABLE lists DROP CONSTRAINT lists_note_check CASCADE;\nALTER TABLE lists ADD CONSTRAINT lists_note_check CHECK (note ~ 'x');"}, "lists: drops a constraint with CASCADE"),
        ("a renamed table stays checked", {"m.sql": "ALTER TABLE items RENAME TO things;\nALTER TABLE things ADD CONSTRAINT f FOREIGN KEY (l) REFERENCES lists (id);"}, r"things: foreign key \(l\) to lists"),
        ("ALTER INDEX renames a table too", {"m.sql": "ALTER INDEX items RENAME TO things;\nALTER TABLE things DROP CONSTRAINT items_pk;"}, "things: drops constraint items_pk"),
        ("another module's global table does not exempt", {"m.sql": "CREATE TABLE x (tenant_id text, device_id text REFERENCES devices (id));"}, r"foreign key \(device_id\) to devices is not composite"),
        ("raw stream in source", {"modules/m/src/a.ts": 'await store.xadd("events:pizza", f);\n'}, r"src/a.ts:1: raw Valkey key"),
        ("raw tenant key in source", {"modules/m/src/a.ts": "key = f't:{tenant}:pizza:cache'\n"}, "raw Valkey key"),
        ("raw platform key in source", {"modules/m/src/a.ts": 'const RING = "m:render:ring";\n'}, r"src/a.ts:1: raw platform key"),
        ("another module's key in a template", {"modules/m/src/a.ts": "redis.get(`screen-render:${id}`);\n", "modules/screen-render/README.md": "a module\n"}, "raw platform key"),
        ("platformKey, other prefixes and Python pass", {"modules/m/src/a.ts": 'platformKey("m", "render", "ring");\nimport "node:fs";\nconst m = "m: started";\n', "modules/m/src/a.py": 'aad = f"m:sub:{tenant}"\n'}, None),
    ]
    fail = 0
    for name, extra, expect in cases:
        with tempfile.TemporaryDirectory() as tmp:
            root = Path(tmp)
            subprocess.run(["git", "init", "-q", str(root)], check=True)
            (root / "scripts").mkdir()
            (root / ALLOW_LIST).write_text(GLOBALS + extra.get("globals", ""))
            files = {
                "modules/m/migrations/001_lists.sql": GOOD + RLS.format(t="lists") + RLS.format(t="items"),
                "modules/m/migrations/002_more.sql": extra.get("m.sql", ""),
            } | extra
            for rel in (k for k in files if "/" in k):
                (root / rel).parent.mkdir(parents=True, exist_ok=True)
                (root / rel).write_text(files[rel])
            subprocess.run(["git", "-C", tmp, "add", "-A"], check=True)
            found = check(root)
            ok = not found if expect is None else any(re.search(expect, p) for p in found)
            print(f"{'ok  ' if ok else 'FAIL'} {name}")
            for p in found:
                print(f"     | {p}", file=sys.stderr)
            fail |= not ok
    return int(fail)


def main(argv: list[str]) -> int:
    if argv[1:2] == ["--self-test"]:
        return self_test()
    root = Path(argv[1] if len(argv) > 1 else Path(__file__).resolve().parent.parent)
    try:
        problems = check(root)
    except (OSError, subprocess.CalledProcessError) as exc:
        print(f"check-tenancy: cannot run: {exc}", file=sys.stderr)
        return 2
    for problem in problems:
        print(problem)
    if problems:
        print(f"check-tenancy: {len(problems)} problem(s); see docs/ci.md#tenancy", file=sys.stderr)
        return 1
    print("check-tenancy: ok")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
