#!/usr/bin/env bash
# No-event-names check: fail if the added lines of a diff contain a forbidden term.
# Terms come from $EVENT_NAME_TERMS (one per line or comma-separated), never from the repo.
# Usage: check-event-names [--dry-run] [BASE_REF]    (default base: origin/main)
#        check-event-names --self-test
# Exempt: git remote URLs on github.com and <org>/<repo> slugs of this org. Nothing
# else: the bare org name or its domain in prose or hostnames still counts if listed.
set -uo pipefail
# Split so this file does not contain the literal name (the check scans its own repo).
org="Tammi""lanit"

dry=0
if [ "${1:-}" = "--dry-run" ]; then dry=1; shift; fi

if [ "${1:-}" = "--self-test" ]; then
  self=$(cd "$(dirname "$0")" && pwd)/check-event-names
  t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
  cd "$t" && git init -q . && git config user.email t@t && git config user.name t
  echo base > a.txt && git add . && git commit -qm base && base=$(git rev-parse HEAD)
  export EVENT_NAME_TERMS=$'FakeFest\n10.9.8.7\n'"${org}"$'\n'"${org}.com"
  fail=0
  expect() { # name, expected exit, file content
    printf '%s\n' "$3" > a.txt; git commit -qam x --allow-empty
    "$self" "$base" >/dev/null 2>&1; rc=$?
    if [ "$rc" = "$2" ]; then echo "ok   $1"; else echo "FAIL $1 (exit $rc, want $2)"; fail=1; fi
    git reset -q --hard "$base"
  }
  expect "clean diff passes" 0 "hello world"
  expect "term fails (case-insensitive)" 1 "welcome to fakefest"
  expect "IP fails" 1 "host 10.9.8.7"
  expect "org/repo slug exempt" 0 "see ${org}/canccuplatform-next"
  expect "bare org name in prose fails" 1 "owner $org"
  expect "org domain as hostname fails" 1 "host ${org}.com"
  expect "org domain URL fails" 1 "https://www.${org}.com/x"
  expect "remote URL exempt" 0 "git clone https://github.com/${org}/fakefest.git"
  expect "ssh remote exempt" 0 "git@github.com:${org}/fakefest.git"
  expect "other URL not exempt" 1 "https://fakefest.example.org/"
  EVENT_NAME_TERMS="" "$self" "$base" >/dev/null 2>&1; rc=$?
  if [ "$rc" = 2 ]; then echo "ok   missing terms fails"; else echo "FAIL missing terms (exit $rc)"; fail=1; fi
  EVENT_NAME_TERMS="" EVENT_NAMES_SKIP_IF_MISSING=1 "$self" "$base" >/dev/null 2>&1; rc=$?
  if [ "$rc" = 0 ]; then echo "ok   missing terms skipped on request"; else echo "FAIL skip (exit $rc)"; fail=1; fi
  exit "$fail"
fi

base="${1:-origin/main}"
terms=$(mktemp); hits=$(mktemp); trap 'rm -f "$terms" "$hits"' EXIT
printf '%s\n' "${EVENT_NAME_TERMS:-}" | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^$' > "$terms"

if [ ! -s "$terms" ]; then
  if [ "${EVENT_NAMES_SKIP_IF_MISSING:-0}" = 1 ]; then
    echo "::warning::EVENT_NAME_TERMS not available (fork PR); no-event-names check skipped"; exit 0
  fi
  echo "error: EVENT_NAME_TERMS is empty; set the secret (see docs/ci.md)" >&2; exit 2
fi

mb=$(git merge-base "$base" HEAD 2>/dev/null || echo "$base")
# Added lines as "file:line:text"
git diff -U0 --no-color "$mb" HEAD | awk '
  /^\+\+\+ /   { f = substr($0, 7); next }
  /^@@/        { split($3, p, ","); n = substr(p[1], 2) + 0; next }
  /^\+/        { print f ":" n ":" substr($0, 2); n++ }
' | sed -E 's#(https?://|ssh://git@|git@)github\.com[:/][A-Za-z0-9_./-]*##g; '"s#${org}/[A-Za-z0-9_.-]+##Ig" \
  | grep -n -i -F -f "$terms" > "$hits" || true

if [ -s "$hits" ]; then
  # Report location only, never the matched text, so the CI log does not leak the list.
  echo "Forbidden event-specific term found at:" >&2
  cut -d: -f2,3 "$hits" | sort -u | awk -F: '{print "  " $1 ":" $2}' >&2
  [ "$dry" = 1 ] && { echo "(dry run: not failing)" >&2; exit 0; }
  exit 1
fi
echo "no-event-names: clean"
