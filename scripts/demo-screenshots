#!/usr/bin/env bash
# Screenshots of the admin pages in the running demo stack, signed in with the CI session
# stub's cookie (deploy/compose.ci.yml). CI runs it in the `demo-stack` check and uploads
# OUT_DIR as an artifact. A page that does not answer 200 fails the run, so a screenshot of
# an error page never passes for a real one.
# Usage: demo-screenshots [--dry-run] [BASE_URL] [OUT_DIR]   (defaults http://127.0.0.1, screenshots)
# The pages open on the demo event's hostname CANCCU_DEMO_HOST (default demo.localhost; the CI
# stack has two events, so IP mode serves none) at BASE_URL's port. Chromium resolves `*.localhost`
# to the loopback itself, so BASE_URL must be this machine.
#        demo-screenshots --install   pulls the Playwright image (CI)
# Needs Docker. The run happens in Playwright's image, which ships Chromium and its system
# libraries: installing them with apt on the runner failed CI whenever the Ubuntu mirrors were
# down (#378). Inside the image the script runs itself directly and needs curl and npx.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2

# The version of the browser tests (playwright-core in modules/theming/package.json and their
# image in modules/theming/README.md); bump them together.
PLAYWRIGHT=1.64.1
IMAGE=mcr.microsoft.com/playwright:v$PLAYWRIGHT-noble
# name|path: the admin pages, in menu order.
PAGES=(
  "settings|/admin/settings"
  "settings-admin|/admin/settings/admin"
  "health-view|/admin/health-view"
  "profile|/admin/profile"
)

usage() { echo "usage: demo-screenshots [--dry-run] [BASE_URL] [OUT_DIR] | --install" >&2; exit 2; }
if [ "${1:-}" = "--install" ]; then
  [ $# = 1 ] || usage
  exec docker pull "$IMAGE"
fi
dry=0
if [ "${1:-}" = "--dry-run" ]; then dry=1; shift; fi
[ $# -le 2 ] || usage
BASE=${1:-http://127.0.0.1}
BASE=${BASE%/}
OUT=${2:-screenshots}
SESSION=${DEMO_SESSION:-demo-ci}
DEMO_HOST=${CANCCU_DEMO_HOST:-demo.localhost}
authority=${BASE#*://}; authority=${authority%%/*}
port=""
[[ $authority =~ :([0-9]+)$ ]] && port=":${BASH_REMATCH[1]}"

if [ "$dry" = 1 ]; then
  echo "dry run, would screenshot (chromium in $IMAGE) into $OUT/:"
  for p in "${PAGES[@]}"; do echo "  ${p%%|*}.png  http://$DEMO_HOST$port${p#*|}"; done
  exit 0
fi

# The image sets PLAYWRIGHT_BROWSERS_PATH to its browsers; anywhere else, run this script there.
# Host network, so BASE_URL means the same in the container; the caller's uid owns the PNGs.
if [ "${PLAYWRIGHT_BROWSERS_PATH:-}" != /ms-playwright ]; then
  command -v docker >/dev/null || { echo "error: docker not found" >&2; exit 2; }
  mkdir -p "$OUT" && out=$(cd "$OUT" && pwd) || exit 2
  exec docker run --rm --network host -u "$(id -u):$(id -g)" -e HOME=/tmp -e DEMO_SESSION="$SESSION" \
    -e CANCCU_DEMO_HOST="$DEMO_HOST" \
    -v "$PWD:/repo:ro" -v "$out:$out" -w /repo "$IMAGE" scripts/demo-screenshots "$BASE" "$out"
fi

for tool in curl npx; do
  command -v "$tool" >/dev/null || { echo "error: $tool not found" >&2; exit 2; }
done
if ! curl -s -o /dev/null --max-time 5 "$BASE/"; then
  echo "error: $BASE does not answer; start the stack first:" >&2
  echo "  docker compose -f deploy/compose.yml -f deploy/compose.ci.yml up -d --build --wait" >&2
  exit 1
fi

mkdir -p "$OUT"
state=$(mktemp)
log=$(mktemp)
trap 'rm -f "$state" "$log"' EXIT
cat > "$state" <<JSON
{"cookies": [{"name": "canccu_session", "value": "$SESSION", "domain": "$DEMO_HOST", "path": "/",
  "expires": -1, "httpOnly": true, "secure": false, "sameSite": "Lax"}], "origins": []}
JSON

fail=0
for p in "${PAGES[@]}"; do
  name=${p%%|*} url=http://$DEMO_HOST$port${p#*|}
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 -H "host: $DEMO_HOST" \
    -H "cookie: canccu_session=$SESSION" "$BASE${p#*|}") || code=000
  if [ "$code" != 200 ]; then
    echo "FAIL $name: $url answered HTTP $code, not 200"; fail=1; continue
  fi
  if npx --yes "playwright@$PLAYWRIGHT" screenshot --browser chromium --full-page \
      --viewport-size "1280, 800" --load-storage "$state" "$url" "$OUT/$name.png" >"$log" 2>&1; then
    echo "ok   $name.png  $url"
  else
    echo "FAIL $name: screenshot of $url failed:"; grep -m3 -i 'error' "$log" | cut -c1-300; fail=1
  fi
done

if [ "$fail" = 0 ]; then echo "demo-screenshots: ${#PAGES[@]} pages in $OUT/"; else echo "demo-screenshots: failed" >&2; fi
exit "$fail"
