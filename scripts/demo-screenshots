#!/usr/bin/env bash
# Screenshots of every user-facing surface of the running demo stack (#376): the admin pages, the
# Theme studio, the phone hub's preview, the agenda and notify pages, and the screens of every
# demo theme, Pulse and device frames, with their readability check (#191; the lists are in
# scripts/demo-screenshots.mjs and modules/screen/test/stack/screens.mjs). CI runs it in the
# `demo-stack` check and uploads OUT_DIR as an artifact, which a user-visible PR's reviewer holds
# against the mockups (AGENTS.md, A package run).
# Usage: demo-screenshots [--dry-run] [--groups LIST] [--check] [BASE_URL] [OUT_DIR]
#          (defaults http://127.0.0.1, screenshots)
#        demo-screenshots --install   pulls the Playwright image (CI)
#   --groups LIST  only these screenshot groups (scripts/demo-screenshots-groups.mjs): one shard of
#                  CI's demo stack, or a module PR's surfaces (docs/ci.md#tiers). A pass with no
#                  shot in them is skipped, so the front pass's seed, the trouble pass's stopped
#                  notify and the last pass's stopped agenda happen only where their shots are
#                  taken.
#   --check        the merge queue's pass: every check, no 4K screen, no PNG of a page.
# BASE_URL is Caddy's address as seen from inside the Caddy container (so not a remote or
# host-published address); the pages open on the demo event's hostname CANCCU_DEMO_HOST (default
# demo.localhost; the CI stack has two events, so IP mode serves none) at its port.
# Needs Docker (the dry run only node). The run happens in Playwright's image, which ships Chromium
# and its system libraries: installing them with apt on the runner failed CI whenever the Ubuntu
# mirrors were down (#378). The image joins the network namespace of the stack's Caddy container,
# found through CANCCU_DEMO_COMPOSE (default `docker compose -f deploy/compose.yml -f
# deploy/compose.ci.yml`, as in scripts/demo-stack-test). The browser then comes from the
# loopback, an address of the demo venue, which the venue IP check needs before a screen pairs or
# plays (contracts/screen.md); from the host, Docker's gateway is the source.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2

# The version of the browser tests (playwright-core in modules/theming/package.json and their
# image in modules/theming/README.md); bump them together.
PLAYWRIGHT=1.64.1
IMAGE=mcr.microsoft.com/playwright:v$PLAYWRIGHT-noble
STACK=modules/screen/test/stack

usage() { echo "usage: demo-screenshots [--dry-run] [--groups LIST] [--check] [BASE_URL] [OUT_DIR] | --install" >&2; exit 2; }
if [ "${1:-}" = "--install" ]; then
  [ $# = 1 ] || usage
  exec docker pull "$IMAGE"
fi
dry=0
picks=()
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry=1; shift ;;
    --groups) [ -n "${2:-}" ] || usage; picks+=(--groups "$2"); shift 2 ;;
    --check) picks+=(--check); shift ;;
    -*) usage ;;
    *) break ;;
  esac
done
[ $# -le 2 ] || usage
BASE=${1:-http://127.0.0.1}
OUT=${2:-screenshots}

if [ "$dry" = 1 ]; then
  command -v node >/dev/null || { echo "error: node not found" >&2; exit 2; }
  echo "(chromium in $IMAGE, in Caddy's network namespace)"
  node scripts/demo-screenshots.mjs --dry-run "${picks[@]}" --base "$BASE" --out "$OUT" || exit 1
  echo "then, after scripts/demo-screenshots-front.sql seeds people and three more events:"
  exec node scripts/demo-screenshots-front.mjs --dry-run "${picks[@]}" --base "$BASE" --out "$OUT"
fi

command -v docker >/dev/null || { echo "error: docker not found" >&2; exit 2; }
read -ra COMPOSE <<< "${CANCCU_DEMO_COMPOSE:-docker compose -f deploy/compose.yml -f deploy/compose.ci.yml}"
caddy=$("${COMPOSE[@]}" ps -q caddy 2>/dev/null | head -n1)
if [ -z "$caddy" ]; then
  echo "error: the stack's caddy container is not running; start the stack first:" >&2
  echo "  docker compose -f deploy/compose.yml -f deploy/compose.ci.yml up -d --build --wait" >&2
  echo "  (another project or files: set CANCCU_DEMO_COMPOSE to its compose command)" >&2
  exit 1
fi

# The script and the stack client keep their repo layout, so the import between them holds.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
MEDIA=modules/screen/test/fixtures/media
mkdir -p "$work/scripts" "$work/$STACK" "$work/$MEDIA" "$work/events/demo/assets" "$OUT" && out=$(cd "$OUT" && pwd) || exit 2
cp scripts/demo-screenshots*.mjs "$work/scripts/" \
  && cp "$STACK"/*.mjs "$work/$STACK/" || exit 2
# The Theme studio's draft takes the demo logo, as an organiser would upload it.
cp events/demo/assets/logo.svg "$work/events/demo/assets/" || exit 2
# The Content page's library uploads a video and a sound (content-fixture.mjs).
cp "$MEDIA/clip-h264-aac.mp4" "$MEDIA/sound.ogg" "$work/$MEDIA/" || exit 2
user="$(id -u):$(id -g)"
# On the default network: Caddy's namespace may not reach the registry.
if ! docker run --rm -u "$user" -e HOME=/tmp -v "$work:/work" -w /work "$IMAGE" \
  npm install --no-save --no-audit --no-fund --loglevel=error "playwright-core@$PLAYWRIGHT" >&2; then
  echo "error: could not install playwright-core $PLAYWRIGHT in $IMAGE" >&2
  exit 1
fi
shoot() {
  docker run --rm --network "container:$caddy" -u "$user" -e HOME=/tmp \
    -e CANCCU_DEMO_HOST -e DEMO_SESSION -v "$work:/work" -v "$out:/out" -w /work "$IMAGE" \
    node "scripts/$1" --base "$BASE" --out /out "${picks[@]}" "${@:2}"
}
# Whether a pass takes a shot in the chosen groups: its dry run, in the image as the pass runs.
# Read whole, then searched: `grep -q` in the pipe stops at the first match, breaks the dry run's
# pipe, and pipefail would read that as "no shot", skipping the pass in silence.
takes() {
  local listed
  listed=$(docker run --rm -u "$user" -e HOME=/tmp -v "$work:/work" -w /work "$IMAGE" \
    node "scripts/$1" --dry-run "${picks[@]}") || { echo "error: $1 --dry-run failed" >&2; exit 1; }
  grep -q -- "$2" <<< "$listed"
}
shoot demo-screenshots.mjs
status=$?
if ! takes demo-screenshots-front.mjs '\.png '; then exit "$status"; fi
# The second pass needs people, a session without a role and events before, after and away from
# their venue, which no API of the CI stack makes; the first pass shows People with nobody else.
if ! "${COMPOSE[@]}" exec -T postgres psql -U canccu -d canccu -v ON_ERROR_STOP=1 -q \
  < scripts/demo-screenshots-front.sql; then
  echo "error: could not seed the front-door screenshots" >&2
  exit 1
fi
shoot demo-screenshots-front.mjs || status=1
# Health with a part down (docs/design/mockups.html, sheet 4), late, as it stops notify (whose
# check-in the front pass shows) for longer than admin's 10 s check. The pass asks for notify
# back (the file start-notify) once its shots of the part down are taken, then follows Health
# until the menu's note clears; notify starts again whatever the pass did.
if takes demo-screenshots.mjs ', --trouble)'; then
  # Whatever ends the run from here (a failed pass, Ctrl-C, a cancelled CI job), notify starts
  # again: a stack left with a part down fails every later check against it.
  trap '"${COMPOSE[@]}" start notify >/dev/null; rm -rf "$work"' EXIT
  "${COMPOSE[@]}" stop notify >/dev/null || status=1
  sleep 15
  rm -f "$work/start-notify"
  shoot demo-screenshots.mjs --trouble &
  pass=$!
  for _ in $(seq 240); do
    if [ -e "$work/start-notify" ] || ! kill -0 "$pass" 2>/dev/null; then break; fi
    sleep 1
  done
  "${COMPOSE[@]}" start notify >/dev/null || status=1
  wait "$pass" || status=1
fi
# Notify's own page with the menu's Health note (#478) needs another part down: the run of show,
# stopped last, since the screens and the run of show's own pages need it. The shot waits for the
# note, so nothing waits for admin's check here; agenda starts again whatever ends the run, as
# notify does above.
if ! takes demo-screenshots.mjs ', --agenda-down)'; then exit "$status"; fi
trap '"${COMPOSE[@]}" start agenda >/dev/null; rm -rf "$work"' EXIT
"${COMPOSE[@]}" stop agenda >/dev/null || status=1
shoot demo-screenshots.mjs --agenda-down || status=1
"${COMPOSE[@]}" start agenda >/dev/null || status=1
exit "$status"
