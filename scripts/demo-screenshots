#!/usr/bin/env bash
# Screenshots of every user-facing surface of the running demo stack (#376): the admin pages, the
# Theme studio, the phone hub's preview, the agenda and notify pages, and the screens of every
# demo theme, Pulse and device frames, with their readability check (#191; the lists are in
# scripts/demo-screenshots.mjs and modules/screen/test/stack/screens.mjs). CI runs it in the
# `demo-stack` check and uploads OUT_DIR as an artifact, which a user-visible PR's reviewer holds
# against the mockups (AGENTS.md, A package run).
# Usage: demo-screenshots [--dry-run] [BASE_URL] [OUT_DIR]   (defaults http://127.0.0.1, screenshots)
#        demo-screenshots --install   pulls the Playwright image (CI)
# BASE_URL is Caddy's address as seen from inside the Caddy container (so not a remote or
# host-published address); the pages open on the demo event's hostname CANCCU_DEMO_HOST (default
# demo.localhost; the CI stack has two events, so IP mode serves none) at its port.
# Needs Docker (the dry run only node). The run happens in Playwright's image, which ships Chromium
# and its system libraries: installing them with apt on the runner failed CI whenever the Ubuntu
# mirrors were down (#378). The image joins the network namespace of the stack's Caddy container,
# found through CANCCU_DEMO_COMPOSE (default `docker compose -f deploy/compose.yml -f
# deploy/compose.ci.yml`, as in scripts/demo-stack-test). The browser then comes from the
# loopback, an address of the demo venue, which the venue IP check needs before a screen pairs or
# plays (contracts/screen.md); from the host, Docker's gateway is the source.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2

# The version of the browser tests (playwright-core in modules/theming/package.json and their
# image in modules/theming/README.md); bump them together.
PLAYWRIGHT=1.64.1
IMAGE=mcr.microsoft.com/playwright:v$PLAYWRIGHT-noble
STACK=modules/screen/test/stack

usage() { echo "usage: demo-screenshots [--dry-run] [BASE_URL] [OUT_DIR] | --install" >&2; exit 2; }
if [ "${1:-}" = "--install" ]; then
  [ $# = 1 ] || usage
  exec docker pull "$IMAGE"
fi
dry=0
if [ "${1:-}" = "--dry-run" ]; then dry=1; shift; fi
[ $# -le 2 ] || usage
BASE=${1:-http://127.0.0.1}
OUT=${2:-screenshots}

if [ "$dry" = 1 ]; then
  command -v node >/dev/null || { echo "error: node not found" >&2; exit 2; }
  echo "(chromium in $IMAGE, in Caddy's network namespace)"
  exec node scripts/demo-screenshots.mjs --dry-run --base "$BASE" --out "$OUT"
fi

command -v docker >/dev/null || { echo "error: docker not found" >&2; exit 2; }
read -ra COMPOSE <<< "${CANCCU_DEMO_COMPOSE:-docker compose -f deploy/compose.yml -f deploy/compose.ci.yml}"
caddy=$("${COMPOSE[@]}" ps -q caddy 2>/dev/null | head -n1)
if [ -z "$caddy" ]; then
  echo "error: the stack's caddy container is not running; start the stack first:" >&2
  echo "  docker compose -f deploy/compose.yml -f deploy/compose.ci.yml up -d --build --wait" >&2
  echo "  (another project or files: set CANCCU_DEMO_COMPOSE to its compose command)" >&2
  exit 1
fi

# The script and the stack client keep their repo layout, so the import between them holds.
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
MEDIA=modules/screen/test/fixtures/media
mkdir -p "$work/scripts" "$work/$STACK" "$work/$MEDIA" "$work/events/demo/assets" "$OUT" && out=$(cd "$OUT" && pwd) || exit 2
cp scripts/demo-screenshots.mjs "$work/scripts/" && cp "$STACK"/*.mjs "$work/$STACK/" || exit 2
# The Theme studio's draft takes the demo logo, as an organiser would upload it.
cp events/demo/assets/logo.svg "$work/events/demo/assets/" || exit 2
# The Content page's library uploads a video and a sound (content-fixture.mjs).
cp "$MEDIA/clip-h264-aac.mp4" "$MEDIA/sound.ogg" "$work/$MEDIA/" || exit 2
user="$(id -u):$(id -g)"
# On the default network: Caddy's namespace may not reach the registry.
if ! docker run --rm -u "$user" -e HOME=/tmp -v "$work:/work" -w /work "$IMAGE" \
  npm install --no-save --no-audit --no-fund --loglevel=error "playwright-core@$PLAYWRIGHT" >&2; then
  echo "error: could not install playwright-core $PLAYWRIGHT in $IMAGE" >&2
  exit 1
fi
shots() {
  docker run --rm --network "container:$caddy" -u "$user" -e HOME=/tmp \
    -e CANCCU_DEMO_HOST -e DEMO_SESSION -v "$work:/work" -v "$out:/out" -w /work "$IMAGE" \
    node scripts/demo-screenshots.mjs --base "$BASE" --out /out "$@"
}
shots
status=$?
# Health with a part down (docs/design/mockups.html, sheet 4): notify stops for one pass, longer
# than admin's 10 s check, and starts again whatever the pass did.
"${COMPOSE[@]}" stop notify >/dev/null || status=1
sleep 15
shots --trouble || status=1
"${COMPOSE[@]}" start notify >/dev/null || status=1
exit "$status"
