#!/usr/bin/env bash
# File-size check (AGENTS.md, the file-size rule; ADR 0019): warn on tracked source files over
# 400 lines, and OpenAPI contracts over 1,500 (contracts/README.md, Shared components). It only
# warns: the health pass decides what to split, so a long file never blocks a merge.
# Usage: check-file-size [DIR]    (default: the repo root; scans `git ls-files`)
#                 check-file-size --self-test
set -uo pipefail
limit=400
openapi_limit=1500
list=scripts/file-size-exemptions.txt

if [ "${1:-}" = "--self-test" ]; then
  self=$(cd "$(dirname "$0")" && pwd)/check-file-size
  t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
  cd "$t" && git init -q .
  fail=0
  unset GITHUB_ACTIONS  # Actions sets it for every step; only the annotation case wants it
  lines() { mkdir -p "$(dirname "$2")"; { [ -n "${3:-}" ] && printf '%s\n' "$3"; seq "$1"; } > "$2"; }
  exempt() { mkdir -p scripts; printf '%s\n' "$@" > "$list"; }
  # check NAME ERE-or-! ERE: run on the tree, expect exit 0 and the output to match (or not)
  check() {
    git add -A; out=$("$self" "$t" 2>&1); rc=$?
    if [ "$rc" != 0 ]; then echo "FAIL $1 (exit $rc, want 0)"; fail=1
    elif [ "$2" = "!" ] && grep -Eq -- "$3" <<<"$out"; then echo "FAIL $1 (unexpected: $3)"; fail=1
    elif [ "$2" != "!" ] && ! grep -Eq -- "$2" <<<"$out"; then echo "FAIL $1 (no match: $2)"; fail=1
    else echo "ok   $1"; fi
    printf '%s\n' "$out" | sed 's/^/     | /' >&2
    git rm -rqf . >/dev/null 2>&1; rm -rf "${t:?}"/*
  }
  lines 400 src/a.ts;                              check "400 lines pass" ! "src/a.ts"
  lines 401 src/a.ts;                              check "401 lines warn" "src/a.ts: 401 lines"
  lines 401 src/a.py;                              check "python is source" "src/a.py: 401"
  lines 401 docs/a.md;                             check "markdown is not source" ! "docs/a.md"
  lines 401 scripts/run "#!/usr/bin/env bash";     check "shebang script is source" "scripts/run: 402"
  lines 401 LICENSE;                               check "plain text is not source" ! "LICENSE"
  lines 1500 contracts/a.openapi.yaml;             check "1500-line OpenAPI passes" ! "a.openapi.yaml"
  lines 1501 contracts/a.openapi.yaml;             check "1501-line OpenAPI warns" "a.openapi.yaml: 1501 lines, over the 1500-line"
  lines 1501 contracts/flags.yaml;                 check "other YAML is not checked" ! "flags.yaml"
  lines 401 src/gen.ts "// @generated by a tool"; check "generated marker exempts" ! "src/gen.ts"
  lines 401 src/gen.py "# Code generated. DO NOT EDIT."; check "DO NOT EDIT exempts" ! "src/gen.py"
  lines 401 src/big.ts; exempt "# comment" "src/big.ts  ported as one unit, split in step 3"
  check "listed path is exempt" ! "src/big.ts"
  lines 401 m/x/legacy/a.py; exempt "m/*/legacy/*.py  vendored legacy code"
  check "listed glob is exempt" ! "m/x/legacy/a.py"
  lines 401 src/big.ts; exempt "src/big.ts"
  check "entry without a reason is reported" "exemption without a reason.*src/big.ts"
  lines 401 src/big.ts; exempt "src/big.ts"
  check "entry without a reason exempts nothing" "src/big.ts: 401"
  lines 401 src/a.ts; GITHUB_ACTIONS=true; export GITHUB_ACTIONS
  check "annotation in Actions" "^::warning file=src/a.ts,line=401::"
  unset GITHUB_ACTIONS
  lines 10 src/a.ts;                               check "clean tree says ok" "check-file-size: ok"
  exit "$fail"
fi

root="${1:-$(git rev-parse --show-toplevel)}"
if ! { cd "$root" && git rev-parse --git-dir >/dev/null; }; then echo "check-file-size: $root is not a git work tree"; exit 2; fi

warn() { # path, lines, message
  if [ "${GITHUB_ACTIONS:-}" = true ]; then echo "::warning file=$1,line=$2::$3"; else echo "$1: $3"; fi
}

# The exemption list: one `<path or glob> <reason>` per line; `#` starts a comment. A glob's `*`
# also matches `/`. An entry without a reason is reported and exempts nothing.
patterns=()
if [ -f "$list" ]; then
  n=0
  # shellcheck disable=SC2094  # warn only prints the list's name
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line="${line%%#*}"
    read -r pat reason <<<"$line"
    [ -z "${pat:-}" ] && continue
    if [ -z "${reason:-}" ]; then warn "$list" "$n" "exemption without a reason, ignored: $pat"; continue; fi
    patterns+=("$pat")
  done < "$list"
fi

# Source: code by extension, or an extensionless file that starts with a shebang. Docs, data,
# lockfiles and config are not source; OpenAPI contracts are checked against their own limit.
is_source() {
  case "$1" in
    *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.py|*.sh|*.bash|*.css|*.scss|*.html|*.svelte|*.vue|*.sql) return 0 ;;
  esac
  case "${1##*/}" in *.*) return 1 ;; esac
  [ "$(head -c 2 -- "$1")" = "#!" ]
}

over=0
while IFS= read -r -d '' f; do
  [ -f "$f" ] || continue
  case "$f" in
    *.openapi.yaml) max=$openapi_limit ;;
    *) is_source "$f" || continue; max=$limit ;;
  esac
  for p in ${patterns[@]+"${patterns[@]}"}; do
    # shellcheck disable=SC2053  # the pattern is a glob on purpose
    [[ $f == $p ]] && continue 2
  done
  head -n 5 -- "$f" | grep -qE '@generated|DO NOT EDIT' && continue
  n=$(wc -l < "$f")
  if [ "$n" -gt "$max" ]; then
    warn "$f" "$((max + 1))" "$n lines, over the $max-line rule (split it, or list it in $list with a reason)"
    over=$((over + 1))
  fi
done < <(git ls-files -z)

if [ "$over" -gt 0 ]; then echo "check-file-size: $over file(s) over their line limit (a warning, not a failure)"
else echo "check-file-size: ok"; fi
