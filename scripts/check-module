#!/usr/bin/env bash
# The generic module check (#213): CI runs every module that has checks through this one
# script, so a new module needs no `.github/` change; the packages run through it too (#253).
# See docs/ci.md#modules.
# Usage: check-module --list [ROOT]           JSON array of the modules under ROOT/modules with checks
#        check-module [--dry-run] MODULE [ROOT]  run the checks of ROOT/modules/MODULE
#        check-module [--dry-run] packages/NAME [ROOT]  run the checks of ROOT/packages/NAME
#        check-module --needs MODULE|packages/NAME [ROOT]  what its CI leg sets up, as key=value
#        check-module --self-test
set -uo pipefail

if [ "${1:-}" = "--self-test" ]; then
  self=$(cd "$(dirname "$0")" && pwd)/check-module
  t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
  fail=0
  check() { # name, expected exit, expected output (exact), args...
    local name=$1 want_rc=$2 want_out=$3; shift 3
    out=$("$self" "$@" 2>&1); rc=$?
    if [ "$rc" = "$want_rc" ] && [ "$out" = "$want_out" ]; then echo "ok   $name"
    else echo "FAIL $name (exit $rc, want $want_rc)"; printf '  got:  %s\n' "$out"; printf '  want: %s\n' "$want_out"; fail=1; fi
  }
  mkdir -p "$t/modules/"{ts,py,both,own,empty,lib} "$t/packages/kit-ts" "$t/packages/ui"
  echo '{}' > "$t/packages/kit-ts/package.json"; echo '{}' > "$t/packages/ui/package.json"
  echo '{"dependencies": {"@canccu/kit": "file:../../packages/kit-ts", "@canccu/ui": "file:../../packages/ui"}}' > "$t/modules/ts/package.json"
  echo '{"dependencies": {}}' > "$t/modules/lib/package.json"
  echo '[project]' > "$t/modules/py/pyproject.toml"
  echo '{}' > "$t/modules/both/package.json"; echo '[project]' > "$t/modules/both/pyproject.toml"
  # A module whose checks cannot run on the bare runner brings its own `check`; it wins.
  echo '[project]' > "$t/modules/own/pyproject.toml"
  # shellcheck disable=SC2016  # expands in the written script, not here
  printf '#!/usr/bin/env bash\necho "own check in $(basename "$PWD")"; exit "${OWN_RC:-0}"\n' > "$t/modules/own/check"
  chmod +x "$t/modules/own/check"

  check "list names the modules with checks, sorted" 0 '["both","lib","own","py","ts"]' --list "$t"
  check "list of a repo without modules is empty" 0 '[]' --list "$t/packages"
  check "node module builds the local packages it uses first" 0 "\
+ (packages/kit-ts) npm ci
+ (packages/ui) npm ci
+ (modules/ts) npm ci
+ (modules/ts) npm run lint
+ (modules/ts) npm run typecheck
+ (modules/ts) npm test" --dry-run ts "$t"
  check "node module without local packages" 0 "\
+ (modules/lib) npm ci
+ (modules/lib) npm run lint
+ (modules/lib) npm run typecheck
+ (modules/lib) npm test" --dry-run lib "$t"
  check "python module" 0 "\
+ (modules/py) python3 -m pip install -e '.[dev]'
+ (modules/py) ruff check .
+ (modules/py) ruff format --check .
+ (modules/py) mypy .
+ (modules/py) pytest" --dry-run py "$t"
  check "a module with both runs both" 0 "\
+ (modules/both) npm ci
+ (modules/both) npm run lint
+ (modules/both) npm run typecheck
+ (modules/both) npm test
+ (modules/both) python3 -m pip install -e '.[dev]'
+ (modules/both) ruff check .
+ (modules/both) ruff format --check .
+ (modules/both) mypy .
+ (modules/both) pytest" --dry-run both "$t"
  check "own check replaces the defaults" 0 "+ (modules/own) ./check" --dry-run own "$t"
  check "own check runs in the module" 0 "\
+ (modules/own) ./check
own check in own" own "$t"
  OWN_RC=3 check "a failing check fails with 1" 1 "\
+ (modules/own) ./check
own check in own
check-module: own failed: ./check" own "$t"
  check "a module without checks is an error" 2 "check-module: modules/empty has no checks (no check script, package.json or pyproject.toml)" empty "$t"
  check "an unknown module is an error" 2 "check-module: no module modules/nope" nope "$t"
  check "a path is not a module name" 2 "check-module: not a module name: ../packages" ../packages "$t"
  # Broken layouts fail loudly in `modules (list)`, never as a module job that cannot pass.
  mkdir -p "$t/bad/modules/Foo_bar" "$t/noexec/modules/x" "$t/dircheck/modules/y/check"
  echo '{}' > "$t/bad/modules/Foo_bar/package.json"
  echo '[project]' > "$t/noexec/modules/x/pyproject.toml"; echo 'exit 0' > "$t/noexec/modules/x/check"
  echo '[project]' > "$t/dircheck/modules/y/pyproject.toml"
  check "list refuses a module name the runner would refuse" 2 "check-module: not a module name: modules/Foo_bar" --list "$t/bad"
  check "list refuses a check that is not executable" 2 "check-module: modules/x/check is not an executable file" --list "$t/noexec"
  check "a check that is not executable never falls back to the defaults" 2 "check-module: modules/x/check is not an executable file" --dry-run x "$t/noexec"
  check "a check folder is not a check" 2 "check-module: modules/y/check is not an executable file" --dry-run y "$t/dircheck"
  # The packages (#253) run the same defaults as a module, named by their path.
  mkdir -p "$t/packages/kit-py"; echo '[project]' > "$t/packages/kit-py/pyproject.toml"
  check "a node package runs the node defaults" 0 "\
+ (packages/ui) npm ci
+ (packages/ui) npm run lint
+ (packages/ui) npm run typecheck
+ (packages/ui) npm test" --dry-run packages/ui "$t"
  check "a python package runs the python defaults" 0 "\
+ (packages/kit-py) python3 -m pip install -e '.[dev]'
+ (packages/kit-py) ruff check .
+ (packages/kit-py) ruff format --check .
+ (packages/kit-py) mypy .
+ (packages/kit-py) pytest" --dry-run packages/kit-py "$t"
  check "an unknown package is an error" 2 "check-module: no package packages/nope" packages/nope "$t"
  check "a nested path is not a package" 2 "check-module: not a module name: packages/kit-ts/src" packages/kit-ts/src "$t"
  check "modules/ is not a prefix" 2 "check-module: not a module name: modules/ts" modules/ts "$t"
  # --needs (#302): a CI leg sets up only the toolchains and services the checks use.
  mkdir -p "$t/modules/ts/test" "$t/modules/py/tests" "$t/packages/kit-ts/test"
  echo 'const url = process.env.CANCCU_DATABASE_URL;' > "$t/modules/ts/test/helpers.ts"
  echo 'URL = os.environ["CANCCU_VALKEY_URL"]' > "$t/modules/py/tests/conftest.py"
  printf 'CANCCU_VALKEY_URL\nCANCCU_DATABASE_URL\n' > "$t/packages/kit-ts/test/x.test.ts"
  echo 'CANCCU_DATABASE_URL' > "$t/modules/both/README.md"
  check "needs: node, and Postgres for a test that reads its URL" 0 "\
node=true
python=false
postgres=true
valkey=false" --needs ts "$t"
  check "needs: python, and Valkey" 0 "\
node=false
python=true
postgres=false
valkey=true" --needs py "$t"
  check "needs: a URL outside the tests starts no service" 0 "\
node=true
python=true
postgres=false
valkey=false" --needs both "$t"
  check "needs: an own check sets up its own toolchain" 0 "\
node=false
python=false
postgres=false
valkey=false" --needs own "$t"
  check "needs: a package, both services" 0 "\
node=true
python=false
postgres=true
valkey=true" --needs packages/kit-ts "$t"
  # shellcheck disable=SC2016  # the check reads the URL; it is never expanded here
  echo 'psql "$CANCCU_DATABASE_URL"' >> "$t/modules/own/check"
  check "needs: an own check that reads a URL gets the service" 0 "\
node=false
python=false
postgres=true
valkey=false" --needs own "$t"
  check "needs: the module name rules hold" 2 "check-module: not a module name: ../x" --needs ../x "$t"
  check "no arguments is a usage error" 2 "usage: check-module --list [ROOT] | [--dry-run|--needs] MODULE|packages/NAME [ROOT] | --self-test"
  exit "$fail"
fi

usage="usage: check-module --list [ROOT] | [--dry-run|--needs] MODULE|packages/NAME [ROOT] | --self-test"

# A `check` that lost its exec bit must not fall back to the defaults: for screen-render
# that would skip the real-deck tests without anyone noticing.
own_check() { # ROOT, DIR (relative): true if DIR has its own check; exits 2 on a broken one
  [ -e "$1/$2/check" ] || return 1
  [ -f "$1/$2/check" ] && [ -x "$1/$2/check" ] && return 0
  echo "check-module: $2/check is not an executable file"; exit 2
}
has_checks() { own_check "$1" "$2" || [ -f "$1/$2/package.json" ] || [ -f "$1/$2/pyproject.toml" ]; }
name_ok() { [[ "$1" =~ ^[a-z][a-z0-9-]*$ ]]; }

if [ "${1:-}" = "--list" ]; then
  root="${2:-$(git rev-parse --show-toplevel)}"
  names=()
  for d in "$root"/modules/*/; do
    [ -d "$d" ] || continue
    n=$(basename "$d")
    has_checks "$root" "modules/$n" || continue
    name_ok "$n" || { echo "check-module: not a module name: modules/$n"; exit 2; }
    names+=("$n")
  done
  # The CI matrix reads this line as JSON; name_ok leaves nothing to escape.
  # ${names[@]+…}: an empty array is unbound under set -u in bash before 4.4 (macOS).
  printf '['; sep=""
  for n in $(printf '%s\n' ${names[@]+"${names[@]}"} | LC_ALL=C sort); do printf '%s"%s"' "$sep" "$n"; sep=","; done
  printf ']\n'
  exit 0
fi

dry=0 needs=0
if [ "${1:-}" = "--dry-run" ]; then dry=1; shift
elif [ "${1:-}" = "--needs" ]; then needs=1; shift; fi
[ $# -ge 1 ] || { echo "$usage"; exit 2; }
module=$1
root="${2:-$(git rev-parse --show-toplevel)}"
# The name comes from the CI matrix and becomes a path: refuse anything but a plain name.
if [[ "$module" == packages/* ]] && name_ok "${module#packages/}"; then
  dir=$module; kind=package
elif name_ok "$module"; then
  dir="modules/$module"; kind=module
else
  echo "check-module: not a module name: $module"; exit 2
fi
[ -d "$root/$dir" ] || { echo "check-module: no $kind $dir"; exit 2; }
has_checks "$root" "$dir" || { echo "check-module: $dir has no checks (no check script, package.json or pyproject.toml)"; exit 2; }

if [ "$needs" = 1 ]; then
  # A service is needed when the tests (or the own check) read its URL. CI sets both URLs on
  # every leg, so a test this misses fails on a refused connection instead of skipping.
  uses() { grep -rqsF "$1" "$root/$dir/test" "$root/$dir/tests" "$root/$dir/check"; }
  own=0; own_check "$root" "$dir" && own=1
  # An own check sets up its own toolchain (screen-render builds its image).
  [ "$own" = 0 ] && [ -f "$root/$dir/package.json" ] && echo node=true || echo node=false
  [ "$own" = 0 ] && [ -f "$root/$dir/pyproject.toml" ] && echo python=true || echo python=false
  uses CANCCU_DATABASE_URL && echo postgres=true || echo postgres=false
  uses CANCCU_VALKEY_URL && echo valkey=true || echo valkey=false
  exit 0
fi

steps=() # "<dir relative to root>|<command>", run in order, stopping at the first failure
if own_check "$root" "$dir"; then
  steps+=("$dir|./check")
else
  if [ -f "$root/$dir/package.json" ]; then
    # A local package (file:../../packages/<name>) builds in its own `npm ci` (its prepare
    # script); the module's `npm ci` copies it, so it must be built first.
    while read -r pkg; do
      [ -f "$root/$pkg/package.json" ] && steps+=("$pkg|npm ci")
    done < <(grep -o 'file:\.\./\.\./packages/[a-z0-9-]*' "$root/$dir/package.json" | sed 's|^file:\.\./\.\./||' | sort -u)
    steps+=("$dir|npm ci" "$dir|npm run lint" "$dir|npm run typecheck" "$dir|npm test")
  fi
  if [ -f "$root/$dir/pyproject.toml" ]; then
    steps+=("$dir|python3 -m pip install -e '.[dev]'" "$dir|ruff check ." "$dir|ruff format --check ." "$dir|mypy ." "$dir|pytest")
  fi
fi

for step in "${steps[@]}"; do
  where=${step%%|*}; cmd=${step#*|}
  echo "+ ($where) $cmd"
  [ "$dry" = 1 ] && continue
  if ! (cd "$root/$where" && bash -c "$cmd"); then
    echo "check-module: $module failed: $cmd"
    exit 1
  fi
done
