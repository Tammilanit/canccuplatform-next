#!/usr/bin/env python3
"""Theme package checks beyond the schema (contracts/theming.md, "The theme package").

The schema checks each value on its own; this checks how they fit together: every file the
manifest names exists, layout and region ids are unique, each region's area fits its grid,
templates and embeds a widget names exist (a template made for that widget type), a `logo`
widget has `images.logo`, each embed's files sit in its own `embeds/<name>/` folder, token
font families are package fonts or generic families, and a simple-mode theme has no CSS,
fonts, templates, embeds or font and size tokens. A manifest the schema rejects is reported
as not checked rather than half-checked.

Usage: check-theme-refs MANIFEST_JSON THEME_DIR   (the manifest already converted to JSON)
       check-theme-refs --self-test
Exit 1 lists the problems; exit 2 on a broken run.
"""

from __future__ import annotations

import json
import sys
import tempfile
from pathlib import Path

GENERIC_FAMILIES = {"system-ui", "ui-monospace", "sans-serif", "serif", "monospace"}


def embed_files(embed: dict) -> list[str]:
    return [embed["entry"], *embed.get("files", [])]


def manifest_files(m: dict) -> list[str]:
    files = list(m.get("images", {}).values()) + list(m.get("css", []))
    for font in m.get("fonts", []):
        files += [font["file"], font["licence_file"]]
    files += [t["file"] for t in m.get("templates", {}).values()]
    for embed in m.get("embeds", {}).values():
        files += embed_files(embed)
    return files


def problems(m: dict, theme_dir: Path) -> list[str]:
    try:
        return _problems(m, theme_dir)
    except (KeyError, TypeError, AttributeError) as e:
        return [f"not_checked: the manifest does not match the schema ({type(e).__name__}: {e})"]


def _problems(m: dict, theme_dir: Path) -> list[str]:
    out: list[str] = []
    for f in sorted(set(manifest_files(m))):
        if not (theme_dir / f).is_file():
            out.append(f"file_missing: {f}")

    templates, embeds = m.get("templates", {}), m.get("embeds", {})
    layout_ids: set[str] = set()
    for layout in m.get("layouts", []):
        lid = layout["id"]
        if lid in layout_ids:
            out.append(f"duplicate_id: layout {lid}")
        layout_ids.add(lid)
        cols, rows = layout["grid"]["columns"], layout["grid"]["rows"]
        region_ids: set[str] = set()
        for region in layout["regions"]:
            rid, a = region["id"], region["area"]
            if rid in region_ids:
                out.append(f"duplicate_id: region {lid}/{rid}")
            region_ids.add(rid)
            if a["column"] + a["columns"] - 1 > cols or a["row"] + a["rows"] - 1 > rows:
                out.append(f"area_outside_grid: {lid}/{rid}")
            for w in region["widgets"]:
                name = w.get("template")
                if name is not None and name not in templates:
                    out.append(f"reference_unknown: template {name} in {lid}/{rid}")
                elif name is not None and templates[name]["widget"] != w["widget"]:
                    out.append(f"reference_unknown: template {name} is not for {w['widget']}")
                if "embed" in w and w["embed"] not in embeds:
                    out.append(f"reference_unknown: embed {w['embed']} in {lid}/{rid}")
                if w["widget"] == "logo" and "logo" not in m.get("images", {}):
                    out.append(f"reference_unknown: images.logo for the logo widget in {lid}/{rid}")

    for name, embed in embeds.items():
        for f in embed_files(embed):
            if not f.startswith(f"embeds/{name}/"):
                out.append(f"reference_unknown: embed {name}: {f} is outside embeds/{name}/")

    families = {f["family"] for f in m.get("fonts", [])} | GENERIC_FAMILIES
    for token, family in m.get("tokens", {}).get("fonts", {}).items():
        if family not in families:
            out.append(f"reference_unknown: font {family} (token {token})")

    if m.get("mode") == "simple":
        for part in ("css", "fonts", "templates", "embeds"):
            if m.get(part):
                out.append(f"mode_mismatch: simple mode with {part}")
        for group in ("fonts", "sizes"):
            if m.get("tokens", {}).get(group):
                out.append(f"mode_mismatch: simple mode with tokens.{group}")
    return out


def self_test() -> int:
    base = {
        "schema_version": 1, "name": "T", "mode": "advanced", "tokens": {},
        "templates": {"big": {"widget": "clock", "file": "templates/big.mustache"}},
        "layouts": [{"id": "main", "name": "M", "aspect": "16:9", "grid": {"columns": 4, "rows": 4},
                     "regions": [{"id": "a", "area": {"column": 1, "row": 1, "columns": 4, "rows": 4},
                                  "widgets": [{"widget": "clock", "template": "big"}]}]}],
    }
    cases: list[tuple[str, dict, str | None]] = []
    cases.append(("valid", base, None))
    m = json.loads(json.dumps(base)); m["layouts"][0]["regions"][0]["area"]["columns"] = 5
    cases.append(("area too wide", m, "area_outside_grid"))
    m = json.loads(json.dumps(base)); m["layouts"].append(json.loads(json.dumps(m["layouts"][0])))
    cases.append(("layout id twice", m, "duplicate_id: layout"))
    m = json.loads(json.dumps(base)); m["layouts"][0]["regions"].append(json.loads(json.dumps(m["layouts"][0]["regions"][0])))
    cases.append(("region id twice", m, "duplicate_id: region"))
    m = json.loads(json.dumps(base)); m["layouts"][0]["regions"][0]["widgets"][0]["template"] = "nope"
    cases.append(("unknown template", m, "reference_unknown: template nope"))
    m = json.loads(json.dumps(base)); m["layouts"][0]["regions"][0]["widgets"][0]["widget"] = "ticker"
    cases.append(("template for another widget", m, "is not for ticker"))
    m = json.loads(json.dumps(base)); m["layouts"][0]["regions"][0]["widgets"] = [{"widget": "embed", "embed": "x"}]
    cases.append(("unknown embed", m, "reference_unknown: embed x"))
    m = json.loads(json.dumps(base)); m["tokens"] = {"fonts": {"body": "Comic Neue"}}
    cases.append(("font not in package", m, "reference_unknown: font Comic Neue"))
    m = json.loads(json.dumps(base)); m["mode"] = "simple"
    cases.append(("simple mode with templates", m, "mode_mismatch"))
    m = json.loads(json.dumps(base)); m["css"] = ["css/missing.css"]
    cases.append(("missing file", m, "file_missing: css/missing.css"))
    m = json.loads(json.dumps(base)); m["embeds"] = {"x": {"entry": "embeds/y/index.html"}}
    cases.append(("embed outside its folder", m, "embed x: embeds/y/index.html"))
    m = json.loads(json.dumps(base)); m["layouts"][0]["regions"][0]["widgets"] = [{"widget": "logo"}]
    cases.append(("logo widget without images.logo", m, "reference_unknown: images.logo"))
    m = json.loads(json.dumps(base)); m["mode"] = "simple"; del m["templates"]
    m["layouts"][0]["regions"][0]["widgets"] = [{"widget": "clock"}]; m["tokens"] = {"sizes": {"gap": "1rem"}}
    cases.append(("simple mode with size tokens", m, "mode_mismatch: simple mode with tokens.sizes"))
    cases.append(("schema-broken manifest", {"layouts": [{"id": "x"}]}, "not_checked"))

    failed = 0
    with tempfile.TemporaryDirectory() as tmp:
        (Path(tmp) / "templates").mkdir()
        (Path(tmp) / "templates/big.mustache").write_text("{{time}}\n")
        for label, manifest, expect in cases:
            got = problems(manifest, Path(tmp))
            ok = (not got) if expect is None else any(expect in p for p in got)
            print(f"{'ok  ' if ok else 'FAIL'} {label}: {got or 'no problems'}")
            failed += not ok
    return 1 if failed else 0


def main(argv: list[str]) -> int:
    if argv == ["--self-test"]:
        return self_test()
    if len(argv) != 2:
        print("usage: check-theme-refs MANIFEST_JSON THEME_DIR | --self-test", file=sys.stderr)
        return 2
    try:
        manifest = json.loads(Path(argv[0]).read_text())
    except (OSError, ValueError) as e:
        print(f"error: cannot read {argv[0]}: {e}", file=sys.stderr)
        return 2
    found = problems(manifest, Path(argv[1]))
    for p in found:
        print(f"  {p}")
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
