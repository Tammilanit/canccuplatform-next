#!/usr/bin/env bash
# Contracts check: validate event profiles and theme packages against their schemas, check
# the paths they name exist (and a theme's references), and lint the OpenAPI contracts. CI runs it as the `contracts` check.
# Usage: check-contracts [--dry-run]     (needs Node 22 and network for npx on first run)
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2

AJV=(npx --yes -p ajv-cli@5.0.0 -p ajv-formats@3.0.1 ajv)
REDOCLY=(npx --yes @redocly/cli@1.34.5)
SCHEMA=contracts/profile.schema.json
THEME_SCHEMA=contracts/theme.schema.json
YAML2JSON=(npx --yes -p js-yaml@4.1.0 js-yaml)

dry=0
if [ "${1:-}" = "--dry-run" ]; then dry=1; shift; fi
if [ $# -gt 0 ]; then echo "usage: check-contracts [--dry-run]" >&2; exit 2; fi

profiles=(events/*/profile.yaml)
apis=(contracts/*.openapi.yaml)
shopt -s nullglob
themes=(events/*/themes/*/theme.yaml)
shopt -u nullglob
[ -e "${profiles[0]}" ] || { echo "error: no events/*/profile.yaml found" >&2; exit 2; }
[ -e "${apis[0]}" ] || { echo "error: no contracts/*.openapi.yaml found" >&2; exit 2; }

if [ "$dry" = 1 ]; then
  echo "dry run, would check:"
  for p in "${profiles[@]}"; do echo "  profile  $p against $SCHEMA, and its asset paths"; done
  for t in "${themes[@]}"; do echo "  theme    $t against $THEME_SCHEMA, then files and references (scripts/check-theme-refs)"; done
  for a in "${apis[@]}"; do echo "  openapi  $a (redocly lint, contracts/redocly.yaml)"; done
  exit 0
fi

command -v npx >/dev/null || { echo "error: npx not found; install Node 22" >&2; exit 2; }
fail=0
quiet() { "$@" 2>&1 | grep -v '^npm \(notice\|warn\)'; return "${PIPESTATUS[0]}"; }

for p in "${profiles[@]}"; do
  if quiet "${AJV[@]}" validate --spec=draft2020 --strict=true -c ajv-formats -s "$SCHEMA" -d "$p"; then
    echo "ok   schema  $p"
  else
    echo "FAIL schema  $p"; fail=1
  fi
  dir=$(dirname "$p"); missing=0
  while IFS= read -r asset; do
    [ -f "$dir/$asset" ] || { echo "FAIL asset   $dir/$asset does not exist"; missing=1; fail=1; }
  done < <(grep -v '^[[:space:]]*#' "$p" | grep -oE 'assets/[A-Za-z0-9._/-]+' | sort -u)
  [ "$missing" = 0 ] && echo "ok   assets  $p"
done

if scripts/check-theme-refs --self-test >/dev/null; then
  echo "ok   self-test scripts/check-theme-refs"
else
  echo "FAIL self-test scripts/check-theme-refs"; fail=1
fi

for t in "${themes[@]}"; do
  if quiet "${AJV[@]}" validate --spec=draft2020 --strict=true -c ajv-formats -s "$THEME_SCHEMA" -d "$t"; then
    echo "ok   schema  $t"
  else
    echo "FAIL schema  $t"; fail=1
  fi
  json=$(mktemp)
  if quiet "${YAML2JSON[@]}" "$t" >"$json" && scripts/check-theme-refs "$json" "$(dirname "$t")"; then
    echo "ok   refs    $t"
  else
    echo "FAIL refs    $t"; fail=1
  fi
  rm -f "$json"
done

for a in "${apis[@]}"; do
  if out=$(quiet "${REDOCLY[@]}" lint --config contracts/redocly.yaml "$a"); then
    echo "ok   openapi $a"
  else
    printf '%s\n' "$out"; echo "FAIL openapi $a"; fail=1
  fi
done

[ "$fail" = 0 ] && echo "contracts: all checks passed" || echo "contracts: checks failed" >&2
exit "$fail"
