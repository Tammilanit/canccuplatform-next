# DOCKER-USER firewall for the web ports (setup/firewall). It runs before Docker, so the rules are
# in place before Docker restores any container that publishes a port. If apply fails (for
# example CP_WEB_ALLOW is empty), the web ports are closed instead, and the unit fails.
# setup/install --boot copies it to /etc/systemd/system, replacing @REPO@ with the checkout path.
[Unit]
Description=CanccuPlatform DOCKER-USER firewall (IPv4 and IPv6)
Before=docker.service
PartOf=docker.service
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '@REPO@/setup/firewall apply || { @REPO@/setup/firewall close; exit 1; }'

[Install]
WantedBy=docker.service
