#!/usr/bin/env bash
# Install a host: check Docker, write deploy/.env, make sure every module image matches the
# checkout's commit (reuse, pull <module>:<CANCCU_VERSION> or build; see setup/README.md), start
# the stack and check its health.
# Usage: install [--dry-run] [--boot]
#   --boot  for a host reachable from outside (needs root): install canccu-firewall.service and
#           canccu-stack.service, enable Docker, the firewall and the stack at boot, put the
#           DOCKER-USER firewall in place BEFORE the stack publishes its ports, then run
#           check-boot. Also installs and enables canccu-deploy.timer (setup/deploy: auto-deploy
#           of main while CANCCU_VERSION is dev). Needs CANCCU_WEB_ALLOW in deploy/.env (see setup/README.md).
# Honours DOCKER_HOST; CANCCU_ENV_FILE replaces deploy/.env (for the self-test).
# Exit 2 = something is missing or unreachable.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2
# shellcheck source=setup/lib.sh
. setup/lib.sh || exit 2
dry=0; boot=0
for a in "$@"; do case "$a" in
  --dry-run) dry=1 ;; --boot) boot=1 ;;
  *) echo "usage: install [--dry-run] [--boot]" >&2; exit 2 ;; esac; done
die() { echo "error: $*" >&2; exit 2; }
step() { if [ "$dry" = 1 ]; then echo "would $*"; else echo "==> $*"; fi; }
newpw() { openssl rand -hex 16 2>/dev/null || head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n'; }

command -v docker >/dev/null || die "docker not found; install Docker Engine with the Compose plugin (CONTRIBUTING.md)"
docker compose version >/dev/null 2>&1 || die "docker compose plugin not found"
docker info >/dev/null 2>&1 || die "cannot reach the Docker daemon (DOCKER_HOST=${DOCKER_HOST:-unset}); is it running and are you in the docker group?"
[ "$dry" = 1 ] || command -v curl >/dev/null || die "curl not found (needed for the health check)"
echo "docker ok"

env=${CANCCU_ENV_FILE:-deploy/.env}
if [ -e "$env" ] && grep -qE '^POSTGRES_PASSWORD=(change-me)?$' "$env"; then
  # The example password must not reach production. Postgres takes the password only when it
  # creates the database, so replacing it is safe only while the volume does not exist.
  if docker volume inspect canccuplatform_postgres-data >/dev/null 2>&1; then
    msg="$env has the example POSTGRES_PASSWORD and the database already exists with it; set a new password in Postgres (ALTER ROLE canccu PASSWORD ...) and in $env"
    if [ "$boot" = 1 ]; then die "$msg"; else echo "warning: $msg" >&2; fi
  else
    step "replace the example POSTGRES_PASSWORD in $env with a random one"
    if [ "$dry" = 0 ]; then
      pw=$(newpw)
      [ -n "$pw" ] || die "cannot generate a password"
      sed -i "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=$pw/" "$env" || die "cannot update $env"
      chmod 600 "$env" || die "cannot chmod $env"
    fi
  fi
elif [ -e "$env" ]; then echo "$env exists, keeping it"
else
  step "write $env from deploy/.env.example with a random POSTGRES_PASSWORD"
  if [ "$dry" = 0 ]; then
    pw=$(newpw)
    [ -n "$pw" ] || die "cannot generate a password"
    (umask 077; sed "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=$pw/" deploy/.env.example > "$env") || die "cannot write $env"
    # under sudo, keep the file usable by the user who runs compose later
    if [ -n "${SUDO_USER:-}" ]; then chown "$SUDO_USER" "$env" || die "cannot chown $env"; fi
  fi
fi

# Notify does not start without these (modules/notify/README.md, Environment). Only an empty or
# missing value is filled, never a set one: a new secrets key loses the stored secrets, and a new
# VAPID key every phone's push subscription.
newsecretskey() { k=$(openssl rand -base64 32) || return 1; echo "1:$k"; }
# A fresh P-256 key from openssl; its DER form holds the 32-byte private scalar after 7 header bytes.
newvapidkey() {
  openssl ecparam -name prime256v1 -genkey -noout -outform DER | tail -c +8 | head -c 32 \
    | base64 | tr '+/' '-_' | tr -d '=\n'
}
fillsecret() {  # <name> <generator>
  [ -e "$env" ] && grep -qE "^$1=.+" "$env" && return 0
  step "generate $1 in $env"
  [ "$dry" = 1 ] && return 0
  v=$($2 2>/dev/null) || v=""
  [ -n "$v" ] || die "cannot generate $1 (is openssl installed?)"
  if grep -qE "^$1=" "$env"; then sed -i "s#^$1=.*#$1=$v#" "$env"; else printf '%s=%s\n' "$1" "$v" >> "$env"; fi \
    || die "cannot update $env"
  chmod 600 "$env" || die "cannot chmod $env"
  if [ -n "${SUDO_USER:-}" ]; then chown "$SUDO_USER" "$env" || die "cannot chown $env"; fi
}
fillsecret CANCCU_SECRETS_KEY newsecretskey
fillsecret CANCCU_NOTIFY_VAPID_PRIVATE_KEY newvapidkey

if [ "$boot" = 1 ]; then
  # The units bake in this path and read deploy/.env only, so validate exactly that, first:
  # a bad list then never closes or opens anything (as root this also test-loads the rules).
  [[ $PWD =~ ^[A-Za-z0-9/._-]+$ ]] || die "the checkout path '$PWD' has characters systemd units cannot take; move it (e.g. /opt/canccuplatform)"
  # The units run setup/ and deploy/ as root: nobody but root and the installing user may write there.
  # Group write is fine for root's group or the user's own (user private group) group.
  owners=(! -user root); groups=(! -group root)
  for u in "${SUDO_USER:-}" "$(id -un)"; do
    [ -n "$u" ] || continue
    owners+=(! -user "$u")
    if getent group "$u" >/dev/null; then groups+=(! -group "$u"); fi
  done
  risky=( \( -perm -002 -o \( -perm -020 "${groups[@]}" \) -o \( "${owners[@]}" \) \) -print )
  writable=$(find "$PWD" -maxdepth 0 "${risky[@]}" && find setup deploy -maxdepth 1 "${risky[@]}") \
    || die "cannot check who may write to $PWD, setup/ and deploy/"
  [ -z "$writable" ] || die "writable by others (world-writable, group-writable by a shared group, or another owner), but run as root by the units: ${writable//$'\n'/ }; fix with chmod o-w,g-w / chown"
  docker_bin=$(command -v docker)
  [[ $docker_bin =~ ^[A-Za-z0-9/._-]+$ ]] || die "the docker path '$docker_bin' has characters systemd units cannot take"
  env -u CANCCU_WEB_ALLOW CANCCU_ENV_FILE="$env" setup/firewall apply --dry-run >/dev/null || die "fix CANCCU_WEB_ALLOW in $env, then run setup/install --boot again"
  if [ "$dry" = 0 ]; then
    [ "$(id -u)" = 0 ] || die "--boot needs root (sudo setup/install --boot)"
    command -v systemctl >/dev/null || die "systemd not found"
  fi
fi

# Module images: nothing starts on an image built from another commit. Every
# canccuplatform-<module>:latest (the name compose gives the images it builds, and what
# canccu-stack starts at boot) must carry the checkout's HEAD in org.opencontainers.image.revision.
# A matching image is reused; otherwise <module>:<CANCCU_VERSION> is pulled from the deploy registry
# and used if it was built from HEAD; otherwise the image is built from the checkout, labelled.
# read-only git, also as root in a user's checkout (no index refresh, no dubious-ownership refusal)
gi() { git -c safe.directory="$PWD" --no-optional-locks "$@"; }
command -v git >/dev/null || die "git not found (needed to match the module images to the checkout)"
head=$(gi rev-parse --verify -q 'HEAD^{commit}') || head=
[[ $head =~ ^[0-9a-f]{40}$ ]] || die "cannot read the checkout's commit (git rev-parse HEAD); run install from a git checkout"
version=$(envval "$env" CANCCU_VERSION); version=${version:-dev}
[[ $version =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ ]] || die "CANCCU_VERSION '$version' in $env is not an image tag (dev or a release tag)"
registry=$(envval "$env" CANCCU_DEPLOY_IMAGES)
if [ -z "$registry" ]; then
  url=$(gi remote get-url origin 2>/dev/null)
  if slug=$(github_slug "$url"); then registry=ghcr.io/${slug,,}; fi
fi
changes=$(gi status --porcelain) || die "cannot read the checkout's state (git status)"
build_labels=(--label "org.opencontainers.image.revision=$head")
if [ -n "$changes" ]; then
  # Such a build is marked, so it is not reused once the checkout is clean again.
  echo "warning: the checkout has local changes: every module image is built from it, with those changes" >&2
  build_labels+=(--label canccu.local-changes=true)
fi
[ -n "$registry" ] || echo "no registry (no CANCCU_DEPLOY_IMAGES in $env and origin is not on GitHub): images are built from the checkout"
labels() { docker image inspect -f '{{index .Config.Labels "org.opencontainers.image.revision"}}|{{index .Config.Labels "canccu.local-changes"}}' "$1" 2>/dev/null; }
short=${head:0:7}
found=0
for f in modules/*/Dockerfile; do
  [ -f "$f" ] || continue
  found=1
  m=${f#modules/}; m=${m%/Dockerfile}; img=canccuplatform-$m:latest
  have=$(labels "$img")
  if [ -z "$changes" ] && [ "$have" = "$head|" ]; then
    if [ "$dry" = 1 ]; then echo "would reuse $img (built from $short)"; else echo "$m: $img was built from $short, reusing it"; fi
    continue
  fi
  rev=${have%%|*}
  if [ -z "$have" ]; then why="no $img yet"
  elif [ -n "$changes" ]; then why="the checkout has local changes"
  elif [ "$rev" = "$head" ]; then why="$img was built with local changes"
  elif [ -z "$rev" ]; then why="$img has no revision label"
  else why="$img was built from ${rev:0:7}, not $short"
  fi
  remote=
  if [ -n "$registry" ] && [ -z "$changes" ]; then remote=$registry/$m:$version; fi
  if [ "$dry" = 1 ]; then
    if [ -n "$remote" ]; then echo "would pull $remote and use it as $img if it was built from $short, else build $f ($why)"
    else echo "would build $f as $img, labelled $short ($why)"; fi
    continue
  fi
  if [ -n "$remote" ]; then
    if docker pull -q "$remote" >/dev/null; then
      got=$(labels "$remote")
      if [ "$got" = "$head|" ]; then
        docker tag "$remote" "$img" || die "cannot tag $remote as $img"
        echo "$m: pulled $remote, built from $short ($why)"
        continue
      fi
      got=${got%%|*}
      why="$why; $remote was built from ${got:0:7}"
    else
      why="$why; cannot pull $remote (the images are private: root needs 'sudo docker login ${registry%%/*}' with a read-packages token, see setup/README.md)"
    fi
  fi
  echo "==> $m: $why; building $f"
  docker build -f "$f" -t "$img" "${build_labels[@]}" . \
    || die "cannot pull or build the image of $m ($why; the build of $f failed); nothing was started"
done
[ "$found" = 1 ] || die "the checkout has no modules/<name>/Dockerfile"

if [ "$boot" = 1 ]; then
  step "install canccu-firewall.service, canccu-stack.service, canccu-deploy.service and canccu-deploy.timer into /etc/systemd/system"
  step "systemctl enable docker canccu-firewall canccu-stack"
  step "systemctl reload canccu-firewall, or start it if inactive (put the DOCKER-USER firewall in place; a restart would restart Docker)"
  if [ "$dry" = 0 ]; then
    for u in canccu-firewall.service canccu-stack.service canccu-deploy.service canccu-deploy.timer; do
      sed "s#@REPO@#$PWD#g; s#@DOCKER@#$docker_bin#g" "setup/$u" > "/etc/systemd/system/$u" || die "cannot write /etc/systemd/system/$u"
    done
    systemctl daemon-reload || die "systemctl daemon-reload failed"
    systemctl enable docker canccu-firewall canccu-stack || die "systemctl enable failed"
    if systemctl is-active --quiet canccu-firewall; then systemctl reload canccu-firewall; else systemctl start canccu-firewall; fi \
      || die "canccu-firewall failed: apply and its fallback close both failed, so the state of the web ports is unknown; see: journalctl -u canccu-firewall"
    setup/firewall check || die "the firewall is not in place; not starting the stack"
  fi
fi

if [ "$boot" = 1 ]; then
  step "systemctl restart canccu-stack (firewall check, then docker compose -f deploy/compose.yml up -d --wait)"
  [ "$dry" = 1 ] || systemctl restart canccu-stack || die "canccu-stack failed; see: journalctl -u canccu-stack"
else
  step "docker compose -f deploy/compose.yml up -d --wait --no-build"
  [ "$dry" = 1 ] || docker compose -f deploy/compose.yml up -d --wait --no-build || die "stack failed to start; see: docker compose -f deploy/compose.yml logs"
fi
if [ "$dry" = 0 ]; then
  for _ in $(seq 1 15); do
    curl -fsS --max-time 5 http://127.0.0.1/api/hello/health >/dev/null 2>&1 && break
    sleep 1
  done
  curl -fsS --max-time 5 http://127.0.0.1/api/hello/health >/dev/null || die "stack is up but /api/hello/health does not answer"
  echo "health ok"
fi

if [ "$boot" = 1 ]; then
  step "systemctl enable --now canccu-deploy.timer (auto-deploy of main; it acts only while CANCCU_VERSION is dev)"
  [ "$dry" = 1 ] || systemctl enable --now canccu-deploy.timer || die "cannot enable canccu-deploy.timer"
  step "setup/check-boot"
  [ "$dry" = 1 ] || setup/check-boot || exit 2
  echo "done. Now run the reboot test in setup/README.md."
else
  echo "done. No firewall was set up: on a host reachable from outside use sudo setup/install --boot (setup/README.md)."
fi
