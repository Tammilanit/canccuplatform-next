#!/usr/bin/env bash
# Auto-deploy of main (dev mode): while CANCCU_VERSION in deploy/.env is `dev`, bring this host to
# origin/main and the module images CI pushed for it (`:dev`), check health, and on failure go
# back to the previous commit and images and open an issue. Run by canccu-deploy.timer as root.
# Usage: deploy [--dry-run]
# Exit 0 = deployed, nothing new, waiting for images, or not in dev mode; 1 = the deploy failed and
# was rolled back, or holds one that did; 2 = something is missing, unreachable or refused.
# Every run writes its result to status.json in the state directory and in the stack's
# deploy-status volume, where the hello module reads it for its health (issue #197).
# deploy/.env (CANCCU_ENV_FILE replaces it): CANCCU_VERSION; CANCCU_DEPLOY_IMAGES (default ghcr.io/<owner>/<repo>
# of the origin remote); CANCCU_DEPLOY_GITHUB_TOKEN (opens the issue: Issues read and write on the repo).
# Environment: CANCCU_DEPLOY_STATE (state dir; default $STATE_DIRECTORY or /var/lib/canccu-deploy),
# CANCCU_DEPLOY_WAIT (seconds to wait for health, default 30), CANCCU_DEPLOY_FIREWALL (default setup/firewall).
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2
# shellcheck source=setup/lib.sh
. setup/lib.sh || exit 2
dry=0
for a in "$@"; do case "$a" in
  --dry-run) dry=1 ;;
  *) echo "usage: deploy [--dry-run]" >&2; exit 2 ;; esac; done
fail_msg=
die() { fail_msg=$*; echo "error: $*" >&2; exit 2; }
say() { echo "deploy: $*"; }
json() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; printf '"%s"' "$s"; }

tools() {
  command -v docker >/dev/null || die "docker not found"
  docker info >/dev/null 2>&1 || die "cannot reach the Docker daemon (DOCKER_HOST=${DOCKER_HOST:-unset})"
  command -v git >/dev/null || die "git not found"
  command -v curl >/dev/null || die "curl not found"
}
if [ "$dry" = 1 ]; then
  tools
  for s in "stop unless CANCCU_VERSION in deploy/.env is dev" "check the checkout is clean and on main" \
    "git fetch origin main" "docker pull <module>:dev for every module with a Dockerfile" \
    "wait until every image was built from origin/main (org.opencontainers.image.revision)" \
    "setup/firewall check" "git merge --ff-only origin/main and tag the images as canccuplatform-<module>:latest" \
    "docker compose -f deploy/compose.yml up -d --wait --no-build, then check health through Caddy" \
    "on failure: go back to the previous commit and images and open an issue" \
    "write the result to status.json (state directory and the deploy-status volume)"; do echo "would $s"; done
  exit 0
fi

env_file=${CANCCU_ENV_FILE:-deploy/.env}
version=$(envval "$env_file" CANCCU_VERSION); version=${version:-dev}
state=${CANCCU_DEPLOY_STATE:-${STATE_DIRECTORY:-/var/lib/canccu-deploy}}
# The compose project is named canccuplatform (deploy/compose.yml), so its deploy-status volume is this.
status_volume=canccuplatform_deploy-status
owner=; norecord=0

# status_dir: where the stack's deploy-status volume lives on this host (rootful Docker)
status_dir() { local v; v=$(docker volume inspect -f '{{.Mountpoint}}' "$status_volume" 2>/dev/null) && [ -d "$v" ] && echo "$v"; }

# put DIR JSON: replace DIR/status.json in one step, readable by the module that serves it
# shellcheck disable=SC2317  # called from record, which the EXIT trap runs
put() { printf '%s\n' "$2" > "$1/status.json.tmp" && chmod 644 "$1/status.json.tmp" && mv "$1/status.json.tmp" "$1/status.json"; }

# record RC: write this run's result for people and for the stack's health: the time, the commit
# the checkout runs, ok or the error in one line, and how many runs in a row have failed since
# when. Runs on every exit once the lock is held (trap), so a run that dies early still shows.
# shellcheck disable=SC2317  # called from the EXIT trap
record() {
  local rc=$1 now commit='' n=0 since='' prev_n=0 prev_since='' err='' res=ok f vol
  # waiting for images is neither a success nor a failure: the last result stands
  [ "$norecord" = 1 ] && return 0
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  [ -n "$owner" ] && commit=$(g rev-parse --verify -q 'HEAD^{commit}' 2>/dev/null)
  [ -f "$state/streak" ] && read -r prev_n prev_since < "$state/streak"
  if [ "$rc" != 0 ]; then
    res=failed; n=$((prev_n + 1)); since=${prev_since:-$now}
    # one line, and never the credentials a URL in a message may carry: health has no sign-in
    err=$(printf '%s' "${fail_msg:-the run stopped (exit $rc)}" | tr '[:cntrl:]' ' ' | sed -E 's#(://)[^/@ ]*@#\1#g')
    echo "$n $since" > "$state/streak"
  else rm -f "$state/streak"; fi
  f=$(printf '{"time":%s,"commit":%s,"result":%s,"error":%s,"failures":%d,"failing_since":%s}' \
    "$(json "$now")" "$(json "$commit")" "$(json "$res")" "$(json "$err")" "$n" "$(json "$since")")
  put "$state" "$f" || echo "warning: cannot write $state/status.json" >&2
  if vol=$(status_dir) && put "$vol" "$f"; then :
  else echo "warning: cannot hand the status to the stack (docker volume $status_volume); see $state/status.json" >&2; fi
}

if [ "$version" != dev ]; then
  # an old status would show a deploy that no longer runs; under the lock, so a dev-mode run
  # still finishing cannot write it back
  if [ -d "$state" ] && exec 9>"$state/lock" && flock -n 9; then
    rm -f "$state/status.json" "$state/streak"
    vol=$(status_dir) && rm -f "$vol/status.json"
  fi
  say "platform version is $version, not dev: auto-deploy is off"; exit 0
fi

mkdir -p "$state" || die "cannot create $state"
exec 9>"$state/lock" || die "cannot open $state/lock"
flock -n 9 || { say "another deploy is running"; exit 0; }
trap 'record $?' EXIT
# In an EXIT trap reached through a signal, $? is the last finished command's status (often 0), so
# a run stopped by the unit's timeout, systemctl stop or a reboot would be recorded as ok.
trap 'exit 143' TERM; trap 'exit 130' INT; trap 'exit 129' HUP
tools

# git runs as the owner of the checkout, so root never writes into a user's checkout.
owner=$(stat -c %U .) || die "cannot read the owner of $PWD"
g() { if [ "$owner" = "$(id -un)" ]; then git "$@"; else runuser -u "$owner" -- git "$@"; fi; }

url=$(g remote get-url origin) || die "the checkout has no origin remote"
slug=$(github_slug "$url") || die "origin ($url) is not a GitHub repository"
images=$(envval "$env_file" CANCCU_DEPLOY_IMAGES); images=${images:-ghcr.io/${slug,,}}
token=$(envval "$env_file" CANCCU_DEPLOY_GITHUB_TOKEN)
wait_s=${CANCCU_DEPLOY_WAIT:-30}
firewall=${CANCCU_DEPLOY_FIREWALL:-setup/firewall}

# pull_failed IMAGE DOCKER_ERROR: stop with why the pull failed, in plain words, and what to do.
# The registry's answer goes to the log only: it may name hosts and addresses of this network,
# and the status is served without sign-in.
pull_failed() {
  local reg=${1%%/*} first cfg=${DOCKER_CONFIG:-$HOME/.docker}/config.json
  first=$(head -n1 <<<"$2")
  echo "docker pull $1: $first" >&2
  case "${2,,}" in
    *denied*|*unauthorized*|*"authentication required"*|*"docker login"*)
      # The images are private, so root needs a login; GHCR also says `denied` for an image
      # that was never pushed, so both messages name that too.
      if [ -r "$cfg" ] && grep -qF "$reg\"" "$cfg"; then
        die "the registry login for $reg no longer works for $1: it has expired or was revoked (or its token cannot read this package, or the image was never pushed). To fix: renew the read-packages token and run 'sudo docker login $reg' again"
      fi
      die "the registry $reg refused to send $1: the images are private and root has no login for $reg. Run 'sudo docker login $reg' with a token that can read packages (setup/README.md, Auto-deploy); with a login, the image may never have been pushed" ;;
    *"no such host"*|*timeout*|*"timed out"*|*"connection refused"*|*"network is unreachable"*|*"dial tcp"*|*"tls handshake"*)
      die "cannot reach the registry $reg to pull $1: check this host's network, DNS and proxy ('curl -sI https://$reg/v2/' should answer)" ;;
    *"manifest unknown"*|*"not found"*)
      die "$1 is not in the registry: the Images workflow has not pushed it (docs/ci.md#images); check its last run on main" ;;
    *) die "cannot pull $1: the registry gave an answer this script does not know; it is in the log (journalctl -u canccu-deploy)" ;;
  esac
}

declare -A new old
modules=(); current=; target=; key=; caddy=0
pending=$state/pending

# switch: bring up the stack as the checkout and the canccuplatform-<module>:latest tags are now,
# and check its health; 0 = healthy. Services the checkout no longer lists are removed. Caddy reads
# deploy/Caddyfile through a bind mount, which compose up does not reload, so it is recreated when
# the Caddyfile differs between the two commits.
switch() {
  docker compose -f deploy/compose.yml up -d --wait --no-build --remove-orphans || { say "the stack did not become healthy"; return 1; }
  # Recreate caddy before any health check whenever the Caddyfile it runs is not the checkout's:
  # the two commits differ in it, or an earlier change never reached it.
  if [ "$caddy" = 1 ] || ! docker compose -f deploy/compose.yml exec -T caddy cat /etc/caddy/Caddyfile 2>/dev/null | cmp -s - deploy/Caddyfile; then
    docker compose -f deploy/compose.yml up -d --wait --no-build --force-recreate caddy || { say "caddy did not restart"; return 1; }
  fi
  # Check only the modules the checkout has now and that run: after a rollback, a module only the
  # failed commit added has no Dockerfile, no container and no route any more.
  local m cid ids checked=() routeless=()
  for m in "${modules[@]}"; do
    g cat-file -e "HEAD:modules/$m/Dockerfile" 2>/dev/null || continue
    cid=$(docker compose -f deploy/compose.yml ps -q "$m" 2>/dev/null)
    [ -z "$cid" ] && continue
    ids=$(docker inspect -f '{{.Image}}' "$cid") || return 1
    [ "$ids" = "$(docker image inspect -f '{{.Id}}' "canccuplatform-$m:latest")" ] || { say "$m does not run the image it should"; return 1; }
    # A module with no network (screen-render) has no route to curl: its Compose healthcheck counts.
    if [ "$(docker inspect -f '{{.HostConfig.NetworkMode}}' "$cid")" = none ]; then routeless+=("$m:$cid"); else checked+=("$m"); fi
  done
  local i u ok
  for i in $(seq 1 "$wait_s"); do
    ok=1
    for m in "${routeless[@]}"; do
      u=${m%%:*}
      [ "$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "${m#*:}")" = healthy ] || { ok=0; break; }
    done
    [ "$ok" = 1 ] && for m in "${checked[@]}"; do
      u=http://127.0.0.1/api/$m/health
      curl -fsS --max-time 5 "$u" >/dev/null 2>&1 || { ok=0; break; }
    done
    [ "$ok" = 1 ] && return 0
    [ "$i" = "$wait_s" ] || sleep 1
  done
  say "health check failed: $u"; return 1
}

# deployed: the switch to $target is healthy
deployed() {
  rm -f "$state/failed" "$pending"
  local m
  for m in "${modules[@]}"; do
    if [ -n "${old[$m]}" ] && [ "${old[$m]}" != "${new[$m]}" ]; then docker image rm "${old[$m]}" >/dev/null 2>&1 || true; fi
  done
  say "deployed ${target:0:7}, health ok"
  exit 0
}

# db_refused: the modules whose recent logs show the database refusing them (roles, passwords,
# rights or schema), as when an older version meets a database a newer one changed. Only their
# names leave this host; the logs stay in it.
db_refused() {
  local m out=()
  for m in "${modules[@]}"; do
    docker compose -f deploy/compose.yml logs --no-color --tail 200 "$m" 2>/dev/null | grep -qE \
      'password authentication failed|role "[^"]+" does not exist|permission denied for (table|schema|relation|sequence|database)|(relation|column) "[^"]+" does not exist|InvalidPasswordError|InsufficientPrivilegeError|Undefined(Table|Column)Error' \
      && out+=("$m")
  done
  [ "${#out[@]}" -gt 0 ] && echo "${out[*]}"
}

# rollback WHY: go back to $current and the previous images, hold this deploy, open an issue, exit 1
rollback() {
  echo "$key" > "$state/failed"
  local m rolled="rolled back to ${current:0:7}, health ok"
  g reset -q --keep "$current" || rolled="ROLLBACK FAILED: cannot reset the checkout to ${current:0:7}"
  for m in "${modules[@]}"; do
    [ -n "${old[$m]}" ] && { docker tag "${old[$m]}" "canccuplatform-$m:latest" || rolled="ROLLBACK FAILED: cannot tag the previous image of $m"; }
  done
  case "$rolled" in ROLLBACK*) ;; *) switch || rolled="ROLLBACK FAILED: the previous version is not healthy either" ;; esac
  local db
  if [[ $rolled == "ROLLBACK FAILED: the previous"* ]] && db=$(db_refused); then
    rolled+="; $db cannot start on the current database, which ${target:0:7} may have changed (roles, schema): restore the database from before ${target:0:7}, or fix forward on main"
  fi
  rm -f "$pending"
  fail_msg="deploy of ${target:0:7} failed ($1); $rolled"
  say "$fail_msg"
  local title body tmp
  title="Auto-deploy of ${target:0:7} failed; ${rolled%%:*}"
  body="## Goal
Find out why the dev host could not deploy main at $target ($1), fix it on main, and see the next deploy pass its health check.
Result of the automatic rollback: $rolled.

## Acceptance criteria
- [ ] The cause is found (on the host: journalctl -u canccu-deploy and docker compose -f deploy/compose.yml logs)
- [ ] A fix is merged to main and the next auto-deploy logs \"health ok\"

## Files likely involved
Depends on the cause: the modules or deploy/ files changed in ${target:0:7}.

## Out of scope
Changes on the host itself: code reaches it only through a merge to main.

Auto-deploy holds this commit and these images, and keeps failing, until a new merge or new images arrive. To retry the same ones on the host: sudo rm $state/failed && sudo systemctl start canccu-deploy"
  if [ -z "$token" ]; then
    echo "error: no CANCCU_DEPLOY_GITHUB_TOKEN in $env_file, so no issue was opened" >&2
  else
    tmp=$(mktemp) || exit 1
    printf '{"title":%s,"body":%s,"labels":["module:deploy"]}' "$(json "$title")" "$(json "$body")" > "$tmp"
    printf 'header = "Authorization: Bearer %s"\n' "$token" \
      | curl -fsS --max-time 20 -K - -X POST -H "Accept: application/vnd.github+json" \
          --data-binary "@$tmp" "https://api.github.com/repos/$slug/issues" >/dev/null \
      || echo "error: could not open an issue on $slug" >&2
    rm -f "$tmp"
  fi
  exit 1
}

# An earlier run stopped between switching and its verdict (a reboot, a kill, the unit's timeout):
# finish it now from what it wrote down, so an unchecked deploy never counts as up to date.
if [ -s "$pending" ]; then
  while read -r k a b; do case "$k" in
    current) current=$a ;; target) target=$a ;; caddy) caddy=$a ;;
    module) modules+=("$a"); old[$a]=${b#-} ;;
  esac; done < "$pending"
  key=$(sed -n 's/^key //p' "$pending")
  for m in "${modules[@]}"; do new[$m]=$(docker image inspect -f '{{.Id}}' "canccuplatform-$m:latest" 2>/dev/null || true); done
  say "an earlier deploy of ${target:0:7} was interrupted; checking it now"
  if [ "$(g rev-parse --verify -q 'HEAD^{commit}')" = "$target" ] && switch; then deployed; fi
  rollback "the deploy was interrupted and is not healthy"
fi

[ "$(g symbolic-ref --short HEAD 2>/dev/null)" = main ] || die "the checkout is not on main; nobody edits code on the VM"
[ -z "$(g status --porcelain --untracked-files=no)" ] || die "the checkout has local changes; nobody edits code on the VM (code arrives only by a merge to main)"
g fetch -q origin main || die "cannot fetch main from origin"
target=$(g rev-parse --verify -q 'FETCH_HEAD^{commit}') || die "cannot read the fetched main"
current=$(g rev-parse --verify -q 'HEAD^{commit}') || die "cannot read HEAD"
g merge-base --is-ancestor "$current" "$target" || die "the checkout has diverged from origin/main; nobody edits code on the VM"

modules=()
while read -r d; do
  m=${d#modules/}
  g cat-file -e "$target:modules/$m/Dockerfile" 2>/dev/null && modules+=("$m")
done < <(g ls-tree --name-only "$target" modules/)
[ "${#modules[@]}" -gt 0 ] || die "main has no modules/<name>/Dockerfile"

missing_new=()
for m in "${modules[@]}"; do
  if ! err=$(docker pull -q "$images/$m:dev" 2>&1 >/dev/null); then
    # A module main just added has no image until its Images job pushes it: that is waiting, not
    # a failure. The other modules are still pulled, so a broken login shows on them.
    if ! g cat-file -e "HEAD:modules/$m/Dockerfile" 2>/dev/null; then
      case "${err,,}" in *"manifest unknown"*|*"not found"*|*denied*) missing_new+=("$m"); continue ;; esac
    fi
    pull_failed "$images/$m:dev" "$err"
  fi
  rev=$(docker image inspect -f '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$images/$m:dev")
  if [ "$rev" != "$target" ]; then norecord=1; say "waiting for the images of ${target:0:7} ($m:dev was built from ${rev:0:7})"; exit 0; fi
  new[$m]=$(docker image inspect -f '{{.Id}}' "$images/$m:dev") || die "cannot inspect $images/$m:dev"
  old[$m]=$(docker image inspect -f '{{.Id}}' "canccuplatform-$m:latest" 2>/dev/null || true)
done

if [ "${#missing_new[@]}" -gt 0 ]; then
  norecord=1; say "waiting for the image of the new module ${missing_new[*]} (not in the registry yet)"; exit 0
fi
changed=0
[ "$current" = "$target" ] || changed=1
for m in "${modules[@]}"; do [ "${new[$m]}" = "${old[$m]}" ] || changed=1; done
[ "$changed" = 1 ] || { say "up to date at ${target:0:7}"; exit 0; }

key="$target"; for m in "${modules[@]}"; do key+=" $m=${new[$m]}"; done
if [ -f "$state/failed" ] && [ "$(cat "$state/failed")" = "$key" ]; then
  # keep failing, so the unit stays failed until something new arrives
  fail_msg="holding: ${target:0:7} with these images failed before and was rolled back; a new merge or new images retry (to retry these now: sudo rm $state/failed && sudo systemctl start canccu-deploy)"
  echo "error: $fail_msg" >&2
  exit 1
fi

"$firewall" check >/dev/null || die "the firewall is not in place; not deploying (see: $firewall check)"
g diff --quiet "$current" "$target" -- deploy/Caddyfile || caddy=1

# Write down how to go back before changing anything, so an interrupted deploy is finished later.
if ! { echo "current $current"; echo "target $target"; echo "caddy $caddy"; echo "key $key"
  for m in "${modules[@]}"; do echo "module $m ${old[$m]:--}"; done; } > "$pending.tmp" || ! mv "$pending.tmp" "$pending"
then die "cannot write $pending"; fi
say "deploying ${target:0:7} (from ${current:0:7})"
g merge -q --ff-only "$target" || { rm -f "$pending"; die "cannot fast-forward the checkout to ${target:0:7}"; }
for m in "${modules[@]}"; do docker tag "${new[$m]}" "canccuplatform-$m:latest" || rollback "cannot tag the image of $m"; done
if switch; then deployed; fi
rollback "the stack did not become healthy with the new images"
