# Starts the platform at boot, after Docker and the DOCKER-USER firewall (cp-firewall.service).
# setup/install --boot copies it to /etc/systemd/system, replacing @REPO@ with the checkout path.
[Unit]
Description=CanccuPlatform stack (docker compose)
Requires=docker.service cp-firewall.service
After=docker.service cp-firewall.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@REPO@
# Never publish the web ports without the firewall in place.
ExecStartPre=@REPO@/setup/firewall check
ExecStart=/usr/bin/docker compose -f deploy/compose.yml up -d --wait
ExecStop=/usr/bin/docker compose -f deploy/compose.yml stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
