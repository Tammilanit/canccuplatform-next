{
  "name": "@canccu/kit",
  "version": "0.1.0",
  "private": true,
  "description": "Shared plumbing for CanccuPlatform modules: bus, health, settings, rights, errors, logging.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fastify": {
      "types": "./dist/adapters/fastify.d.ts",
      "default": "./dist/adapters/fastify.js"
    },
    "./web": {
      "types": "./dist/adapters/web.d.ts",
      "default": "./dist/adapters/web.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "iovalkey": "0.4.0",
    "pino": "10.4.0",
    "uuid": "14.0.3"
  },
  "peerDependencies": {
    "fastify": "5.12.8"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "10.14.0",
    "fastify": "5.12.8",
    "pg": "^8.23.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
