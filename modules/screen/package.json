{
  "name": "@canccu/screen",
  "version": "0.1.0",
  "private": true,
  "description": "The screen module: paired devices, zones and what the venue screens show (contracts/screen.md).",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@canccu/kit": "file:../../packages/kit-ts",
    "@fastify/multipart": "10.1.8",
    "fastify": "5.12.8",
    "iovalkey": "0.4.0",
    "pg": "8.23.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
