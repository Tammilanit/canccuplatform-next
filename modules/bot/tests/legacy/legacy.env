# A scrubbed copy of a legacy bot's .env: every key the legacy bot reads, with placeholder values.
# The test fills the ids in braces from the fake Discord; no real name, id or host here.
DISCORD_TOKEN={token}
GUILD_ID={guild_id}
ADMIN_ROLE_NAME="Demo Admin"
TOURNAMENT_CHANNEL_ID={tournaments}
FINALS_CHANNEL_ID={finals}
FINALS_TEST_CHANNEL_ID={finals_test}
MANAGER_ALERT_CHANNEL_ID={alerts}
GAME_THRESHOLD=4
BOT_TICKER_TTL_SECONDS=1800

export GAME_DETECTION_ENABLED=true
PRESENCE_TRACKING_ENABLED=true
PRESENCE_INTERVAL=60
VOICE_INTERVAL=30
GAME_INTERVAL=30
RETENTION_HOURS=96
STATS_HISTORY_PUBLISH_SECONDS=300
MAX_POLL_OPTIONS=10
MIN_POLL_DURATION=30
POLL_RESULT_DISPLAY_SECONDS=180
TICKER_RSS_PORT=0
TICKER_RSS_CHANNEL_TITLE='Demo Ticker'
DISCORD_LOGIN_LINK_HMAC_SECRET=placeholder-link-secret
SIGNAGE_INSTANCE_ID=demo-screen
CANCCUSIGNAGE_CONTROL_URL=http://signage.example.test
CANCCUSIGNAGE_CONTROL_TOKEN=placeholder-control-token
MANAGER_URL=http://manager.example.test
MANAGER_TOKEN=placeholder-manager-token
MANAGER_ALERT_TOKEN=placeholder-alert-token
MANAGER_ALERT_DM_USERS=100000000000000011,100000000000000012
FINALS_PROVIDER_TOKEN=placeholder-finals-bearer
TOURNEY_BASE_URL=http://tourney.example.test:3000
TOURNEY_PUBLIC_URL=https://tourney.example.test
API_URL=https://site.example.test/api
API_SECRET=placeholder-site-secret
FRONTEND_URL=https://site.example.test
EVENT_TIMEZONE=UTC
LOG_LEVEL=INFO
